                            <NavLink class="nav-link" href="staff/appointments">
                                <i class="fas fa-calendar-check me-2"></i> My Assignments
                            </NavLink>
                        </div>

                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="staff/samples">
                                <i class="fas fa-flask me-2"></i> Sample Processing
                            </NavLink>
                        </div>

                       
                    </Authorized>
                </AuthorizeView>

                <!-- Manager Navigation -->
                <AuthorizeView Roles="Manager,Admin" Context="managerAuth">
                    <Authorized>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="manager/dashboard">
                                <i class="fas fa-chart-line me-2"></i> Manager Dashboard
                            </NavLink>
                        </div>

                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="manager/appointments">
                                <i class="fas fa-calendar-check me-2"></i> Appointment Overview
