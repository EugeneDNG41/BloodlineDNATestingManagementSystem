</style>

@code {
    private string? currentUrl;
    private string? userName;
    private string? userRole;
    private string? userProfilePicture;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        await LoadUserInfo();
    }

    private async Task LoadUserInfo()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            userName = user.Identity.Name;

            // Get user role
            if (user.IsInRole("Admin"))
                userRole = "Administrator";
            else if (user.IsInRole("Manager"))
                userRole = "Manager";
            else if (user.IsInRole("Staff"))
                userRole = "Staff Member";
            else if (user.IsInRole("Customer"))
                userRole = "Customer";
            else
                userRole = "Guest";

            // You can load profile picture from claims or database
            userProfilePicture = user.FindFirst("ProfilePictureUrl")?.Value;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    // private async Task Logout()
    // {
    //     await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('logoutForm').submit()");
    // }

    private async Task LogoutAsync()
    {
        await SignInManager.SignOutAsync();
        NavigationManager.NavigateTo("/", forceLoad: true);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

<!-- Hidden logout form -->
<form id="logoutForm" action="/account/logout" method="post" style="display: none;">
    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
</form>