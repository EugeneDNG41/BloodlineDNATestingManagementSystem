                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="samples">
                                <i class="fas fa-microscope me-2"></i> Sample Tracking
                            </NavLink>
                        </div>

                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="feedback">
