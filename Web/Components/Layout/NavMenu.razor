                        </div>

                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="manager/staff">
                                <i class="fas fa-user-tie me-2"></i> Staff Management
                            </NavLink>
                        </div>

                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="manager/reports">
                                <i class="fas fa-chart-bar me-2"></i> Reports & Analytics
                            </NavLink>
                        </div>

                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="manager/services">
                                <i class="fas fa-cog me-2"></i> Service Oversight
                            </NavLink>
                        </div>

                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="manager/quality">
                                <i class="fas fa-award me-2"></i> Quality Control
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>

