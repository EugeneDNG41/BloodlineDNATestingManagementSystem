@page "/samples/{id:int}"
@using Microsoft.EntityFrameworkCore
@using Data.Entities
@using Data.Enum
@using Web.Components.Account
@using Microsoft.AspNetCore.Authorization
@inject IdentityUserAccessor UserAccessor
@inject Data.AppDbContext DbContext
@attribute [Authorize(Roles = "User")]

<PageTitle>Sample Details</PageTitle>

@if (sample != null)
{
    <div class="container py-4">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/samples">Sample Tracking</a></li>
                <li class="breadcrumb-item active">Sample @sample.Id.ToString("D6")</li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3 class="mb-0">Sample @sample.Id.ToString("D6")</h3>
                        <span class="badge @GetSampleStatusBadgeClass(sample.Status) fs-6">
                            @sample.Status
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h6>Sample Information</h6>
                                <p class="mb-1"><strong>Type:</strong> @sample.Type</p>
                                <p class="mb-1"><strong>Collection Method:</strong> @sample.CollectionMethod</p>
                                <p class="mb-0"><strong>Collection Date:</strong> @sample.CollectionDate.ToString("MMMM dd, yyyy")</p>
                            </div>
                            <div class="col-md-6">
                                <h6>Processing Information</h6>
                                <p class="mb-1">
                                    <strong>Received Date:</strong> 
                                    @if (sample.ReceivedDate.HasValue)
                                    {
                                        @sample.ReceivedDate.Value.ToString("MMMM dd, yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not yet received</span>
                                    }
                                </p>
                                <p class="mb-0">
                                    <strong>Processing Time:</strong> 
                                    @if (sample.ReceivedDate.HasValue)
                                    {
                                        @((DateTime.Now - sample.ReceivedDate.Value).Days.ToString() + " days")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </p>
                            </div>
                        </div>

                        <!-- Progress Timeline -->
                        <div class="mb-4">
                            <h6>Processing Timeline</h6>
                            <div class="timeline">
                                <div class="timeline-item @(sample.Status >= SampleStatus.Collected ? "completed" : "")">
                                    <div class="timeline-marker">
                                        <i class="fas fa-vial"></i>
                                    </div>
                                    <div class="timeline-content">
                                        <h6>Sample Collected</h6>
                                        <p class="text-muted mb-0">@sample.CollectionDate.ToString("MMM dd, yyyy")</p>
                                    </div>
                                </div>
                                
                                <div class="timeline-item @(sample.Status >= SampleStatus.Received ? "completed" : "")">
                                    <div class="timeline-marker">
                                        <i class="fas fa-box"></i>
                                    </div>
                                    <div class="timeline-content">
                                        <h6>Sample Received</h6>
                                        <p class="text-muted mb-0">
                                            @if (sample.ReceivedDate.HasValue)
                                            {
                                                @sample.ReceivedDate.Value.ToString("MMM dd, yyyy")
                                            }
                                            else
                                            {
                                                <span>Pending</span>
                                            }
                                        </p>
                                    </div>
                                </div>
                                
                                <div class="timeline-item @(sample.Status >= SampleStatus.Processing ? "completed" : "")">
                                    <div class="timeline-marker">
                                        <i class="fas fa-microscope"></i>
                                    </div>
                                    <div class="timeline-content">
                                        <h6>Analysis in Progress</h6>
                                        <p class="text-muted mb-0">
                                            @if (sample.Status >= SampleStatus.Processing)
                                            {
                                                <span>In progress</span>
                                            }
                                            else
                                            {
                                                <span>Waiting</span>
                                            }
                                        </p>
                                    </div>
                                </div>
                                
                                <div class="timeline-item @(sample.Status >= SampleStatus.Completed ? "completed" : "")">
                                    <div class="timeline-marker">
                                        <i class="fas fa-check-circle"></i>
                                    </div>
                                    <div class="timeline-content">
                                        <h6>Analysis Complete</h6>
                                        <p class="text-muted mb-0">
                                            @if (sample.Status >= SampleStatus.Completed)
                                            {
                                                <span>Results available</span>
                                            }
                                            else
                                            {
                                                <span>Pending</span>
                                            }
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(sample.Notes))
                        {
                            <div class="mb-4">
                                <h6>Additional Notes</h6>
                                <div class="bg-light p-3 rounded">
                                    <p class="mb-0">@sample.Notes</p>
                                </div>
                            </div>
                        }

                        @if (sample.Status == SampleStatus.Rejected)
                        {
                            <div class="alert alert-danger">
                                <h6 class="alert-heading">Sample Rejected</h6>
                                <p class="mb-0">This sample could not be processed. Please contact support for more information or to schedule a new collection.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">Sample Status</h5>
                    </div>
                    <div class="card-body">
                        <div class="text-center mb-3">
                            <div class="progress mb-2" style="height: 20px;">
                                <div class="progress-bar @GetProgressBarClass(sample.Status)" 
                                     style="width: @GetProgressPercentage(sample.Status)%">
                                    @GetProgressPercentage(sample.Status)%
                                </div>
                            </div>
                            <p class="mb-0">
                                <strong>Status:</strong> 
                                <span class="badge @GetSampleStatusBadgeClass(sample.Status)">
                                    @sample.Status
                                </span>
                            </p>
                        </div>

                        @if (sample.Status == SampleStatus.Completed)
                        {
                            <div class="d-grid">
                                <a href="/results?sampleId=@sample.Id" class="btn btn-primary">
                                    <i class="fas fa-file-medical me-2"></i>View Results
                                </a>
                            </div>
                        }
                        else if (sample.Status == SampleStatus.Rejected)
                        {
                            <div class="d-grid">
                                <button class="btn btn-warning">
                                    <i class="fas fa-redo me-2"></i>Request Recollection
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <div class="card shadow-sm mt-3">
                    <div class="card-body">
                        <h6><i class="fas fa-info-circle text-info me-2"></i>Expected Timeline</h6>
                        <ul class="small mb-0">
                            <li>Collection: Day 0</li>
                            <li>Lab Receipt: 1-2 days</li>
                            <li>Processing: 3-14 days</li>
                            <li>Results: 7-21 days total</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }
    
    .timeline::before {
        content: '';
        position: absolute;
        left: 15px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #dee2e6;
    }
    
    .timeline-item {
        position: relative;
        margin-bottom: 30px;
    }
    
    .timeline-marker {
        position: absolute;
        left: -22px;
        top: 0;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #6c757d;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
    }
    
    .timeline-item.completed .timeline-marker {
        background: #28a745;
    }
    
    .timeline-content h6 {
        margin-bottom: 5px;
        color: #495057;
    }
    
    .timeline-item.completed .timeline-content h6 {
        color: #28a745;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }
    private User user = default!;
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private Sample? sample;

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        await LoadSample();
    }

    private async Task LoadSample()
    {
        sample = await DbContext.Samples
            .FirstOrDefaultAsync(s => s.Id == Id && s.DonorId == user.Id);
    }

    private string GetSampleStatusBadgeClass(SampleStatus status)
    {
        return status switch
        {
            SampleStatus.Collected => "bg-info",
            SampleStatus.Received => "bg-primary",
            SampleStatus.Processing => "bg-warning",
            SampleStatus.Completed => "bg-success",
            SampleStatus.Rejected => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetProgressBarClass(SampleStatus status)
    {
        return status switch
        {
            SampleStatus.Collected => "bg-info",
            SampleStatus.Received => "bg-primary",
            SampleStatus.Processing => "bg-warning",
            SampleStatus.Completed => "bg-success",
            SampleStatus.Rejected => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private int GetProgressPercentage(SampleStatus status)
    {
        return status switch
        {
            SampleStatus.Collected => 25,
            SampleStatus.Received => 50,
            SampleStatus.Processing => 75,
            SampleStatus.Completed => 100,
            SampleStatus.Rejected => 0,
            _ => 0
        };
    }
}
