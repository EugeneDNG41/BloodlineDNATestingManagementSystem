@page "/samples/{id:int}"
@using Data.Entities
@using Data.Enum
@using Web.Components.Account
@using Microsoft.AspNetCore.Authorization
@using global::Services.Interfaces
@inject IdentityUserAccessor UserAccessor
@inject ISampleService SampleService
@attribute [Authorize(Roles = "Customer")]

<PageTitle>Sample Details</PageTitle>

@if (sample is null)
{
    @if (isLoading)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
            <h4>Sample Not Found</h4>
            <p class="text-muted">The requested sample could not be found or you do not have permission to view it.</p>
            <a href="/samples" class="btn btn-primary">Back to Sample Tracking</a>
        </div>
    }
}
else
{
    <div class="container py-4">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/samples">Sample Tracking</a></li>
                <li class="breadcrumb-item active">Sample @sample.Id.ToString("D6")</li>
            </ol>
        </nav>

        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="mb-0">Sample @sample.Id.ToString("D6")</h3>
                <span class="badge @GetSampleStatusBadgeClass(sample.Status) fs-6">@sample.Status</span>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6>Sample Information</h6>
                        <p class="mb-1"><strong>Type:</strong> @sample.Type</p>
                        <p class="mb-1"><strong>Collection Method:</strong> @sample.CollectionMethod</p>
                        <p class="mb-0"><strong>Collection Date:</strong> @sample.CollectionDate.ToString("MMMM dd, yyyy")</p>
                    </div>
                    <div class="col-md-6">
                        <h6>Processing Information</h6>
                        <p class="mb-1">
                            <strong>Received Date:</strong>
                            @if (sample.ReceivedDate.HasValue)
                            {
                                @sample.ReceivedDate.Value.ToString("MMMM dd, yyyy")
                            }
                            else
                            {
                                <span class="text-muted">Not yet received</span>
                            }
                        </p>
                    </div>
                </div>

                <div class="mb-4">
                    <h6>Processing Timeline</h6>
                    <div class="timeline">
                        <div class="timeline-item @(sample.Status >= SampleStatus.Collected ? "completed" : "")">
                            <div class="timeline-marker"><i class="fas fa-vial"></i></div>
                            <div class="timeline-content">
                                <h6>Sample Collected</h6>
                                <p class="text-muted mb-0">@sample.CollectionDate.ToString("MMM dd, yyyy")</p>
                            </div>
                        </div>
                        <div class="timeline-item @(sample.Status >= SampleStatus.Received ? "completed" : "")">
                            <div class="timeline-marker"><i class="fas fa-box"></i></div>
                            <div class="timeline-content">
                                <h6>Sample Received at Lab</h6>
                                <p class="text-muted mb-0">@(sample.ReceivedDate.HasValue? sample.ReceivedDate.Value.ToString("MMM dd, yyyy") : "Pending")</p>
                            </div>
                        </div>
                        <div class="timeline-item @(sample.Status >= SampleStatus.Processing ? "completed" : "")">
                            <div class="timeline-marker"><i class="fas fa-microscope"></i></div>
                            <div class="timeline-content">
                                <h6>Analysis in Progress</h6>
                                <p class="text-muted mb-0">@(sample.Status >= SampleStatus.Processing ? "In progress" : "Waiting")</p>
                            </div>
                        </div>
                        <div class="timeline-item @(sample.Status >= SampleStatus.Completed ? "completed" : "")">
                            <div class="timeline-marker"><i class="fas fa-check-circle"></i></div>
                            <div class="timeline-content">
                                <h6>Analysis Complete</h6>
                                <p class="text-muted mb-0">@(sample.Status >= SampleStatus.Completed ? "Results are available" : "Pending")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }

        .timeline::before {
            content: '';
            position: absolute;
            left: 15px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #dee2e6;
        }

    .timeline-item {
        position: relative;
        margin-bottom: 30px;
    }

    .timeline-marker {
        position: absolute;
        left: -22px;
        top: 0;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #adb5bd; /* Default gray */
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
    }

    .timeline-item.completed .timeline-marker {
        background: #198754; /* Success green */
    }

    .timeline-content h6 {
        margin-bottom: 5px;
        color: #6c757d;
    }

    .timeline-item.completed .timeline-content h6 {
        color: #212529;
        font-weight: bold;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private User user = default!;
    private Sample? sample;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        sample = await SampleService.GetSampleDetailsAsync(Id, user.Id);
        isLoading = false;
    }

    private string GetSampleStatusBadgeClass(SampleStatus status) => status switch
    {
        SampleStatus.Collected => "bg-info text-dark",
        SampleStatus.Received => "bg-primary",
        SampleStatus.Processing => "bg-warning text-dark",
        SampleStatus.Completed => "bg-success",
        SampleStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };
}