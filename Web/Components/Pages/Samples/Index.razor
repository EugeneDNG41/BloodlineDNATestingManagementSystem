@page "/samples"
@using Microsoft.EntityFrameworkCore
@using Data.Entities
@using Data.Enum
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims;
@using Web.Components.Account
@using global::Services.Interfaces
@inject IdentityUserAccessor UserAccessor
@inject ISampleService SampleService
@attribute [Authorize(Roles = "Customer")]

<PageTitle>Sample Tracking</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">Sample Tracking</h1>
    </div>

    @if (samples is null)
    {
        <p><em>Loading...</em></p>
    }
    else if (samples.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sample ID</th>
                                <th>Type</th>
                                <th>Collection Date</th>
                                <th>Status</th>
                                <th>Progress</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sample in samples)
                            {
                                <tr>
                                    <td><strong>@sample.Id.ToString("D6")</strong></td>
                                    <td>@sample.Type</td>
                                    <td>@sample.CollectionDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <span class="badge @GetSampleStatusBadgeClass(sample.Status)">
                                            @sample.Status
                                        </span>
                                    </td>
                                    <td>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar @GetProgressBarClass(sample.Status)"
                                                 style="width: @GetProgressPercentage(sample.Status)%"></div>
                                        </div>
                                        <small class="text-muted">@GetProgressPercentage(sample.Status)%</small>
                                    </td>
                                    <td>
                                        <a href="/samples/@sample.Id" class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-vial fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">No samples found</h4>
            <p class="text-muted">Your DNA samples will appear here once collected.</p>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    private User user = default!;
    private List<Sample> samples = new();

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        var sampleList = await SampleService.GetSamplesByDonorIdAsync(user.Id);
        if (sampleList != null)
        {
            samples = sampleList.ToList();
        }
    }

    private string GetSampleStatusBadgeClass(SampleStatus status) => status switch
    {
        SampleStatus.Collected => "bg-info text-dark",
        SampleStatus.Received => "bg-primary",
        SampleStatus.Processing => "bg-warning text-dark",
        SampleStatus.Completed => "bg-success",
        SampleStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetProgressBarClass(SampleStatus status) => status switch
    {
        SampleStatus.Completed => "bg-success",
        SampleStatus.Rejected => "bg-danger",
        _ => "bg-primary"
    };

    private int GetProgressPercentage(SampleStatus status) => status switch
    {
        SampleStatus.Collected => 25,
        SampleStatus.Received => 50,
        SampleStatus.Processing => 75,
        SampleStatus.Completed => 100,
        _ => 0
    };
}