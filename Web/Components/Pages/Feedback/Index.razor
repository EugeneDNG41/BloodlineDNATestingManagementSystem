@page "/feedback"
@using Microsoft.EntityFrameworkCore
@using Data.Entities
@using Data.Enum
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims;
@using Web.Components.Account
@inject IdentityUserAccessor UserAccessor
@inject Data.AppDbContext DbContext
@attribute [Authorize(Roles = "User")]

<PageTitle>My Feedback</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">My Feedback & Support</h1>
        <a href="/feedback/create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Submit Feedback
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-md-8">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Search feedback..." @bind="searchTerm" @oninput="FilterFeedback">
                <button class="btn btn-outline-secondary" type="button">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
        <div class="col-md-4">
            <select class="form-select" @bind="SelectedStatus">
                <option value="">All Status</option>
                @foreach (var status in Enum.GetValues<FeedbackStatus>())
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>
    </div>

    @if (filteredFeedback?.Any() == true)
    {
        <div class="row">
            @foreach (var feedback in filteredFeedback)
            {
                <div class="col-lg-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <span class="badge @GetFeedbackTypeBadgeClass(feedback.Type)">
                                        @feedback.Type
                                    </span>
                                </div>
                                <div class="text-end">
                                    <span class="badge @GetFeedbackStatusBadgeClass(feedback.Status)">
                                        @feedback.Status
                                    </span>
                                    <br>
                                    <small class="text-muted">@feedback.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                            </div>
                            
                            <p class="card-text">
                                @(feedback.Message.Length > 150 ? feedback.Message.Substring(0, 150) + "..." : feedback.Message)
                            </p>
                            
                            <div class="d-flex gap-2 mt-auto">
                                <a href="/feedback/@feedback.Id" class="btn btn-outline-primary btn-sm">
                                    View Details
                                </a>
                                @if (feedback.Status == FeedbackStatus.Pending)
                                {
                                    <button class="btn btn-outline-secondary btn-sm">
                                        Edit
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-comments fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">No feedback submitted</h4>
            <p class="text-muted">Share your experience or get support by submitting feedback</p>
            <a href="/feedback/create" class="btn btn-primary">Submit Feedback</a>
        </div>
    }
</div>

@code {
    private User user = default!;
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    private List<Feedback> feedback = new();
    private List<Feedback> filteredFeedback = new();
    private string searchTerm = "";
    private string selectedStatus = "";
    public string SelectedStatus
    {
        get => selectedStatus;
        set
        {
            selectedStatus = value;
            FilterFeedback();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        await LoadFeedback();
        filteredFeedback = feedback.ToList();
    }

    private async Task LoadFeedback()
    {
        feedback = await DbContext.Feedbacks
            .Where(f => f.UserId == user.Id)
            .OrderByDescending(f => f.CreatedAt)
            .ToListAsync();
    }

    private void FilterFeedback()
    {
        filteredFeedback = feedback.Where(f =>
            (string.IsNullOrEmpty(selectedStatus) || f.Status.ToString() == selectedStatus) &&
            (string.IsNullOrEmpty(searchTerm) || 
             f.Message.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        ).ToList();
    }

    private string GetFeedbackTypeBadgeClass(FeedbackType type)
    {
        return type switch
        {
            FeedbackType.Service => "bg-primary",
            FeedbackType.Appointment => "bg-info",
            FeedbackType.General => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private string GetFeedbackStatusBadgeClass(FeedbackStatus status)
    {
        return status switch
        {
            FeedbackStatus.Pending => "bg-warning",
            FeedbackStatus.Reviewed => "bg-info",
            FeedbackStatus.Resolved => "bg-success",
            FeedbackStatus.Closed => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}
