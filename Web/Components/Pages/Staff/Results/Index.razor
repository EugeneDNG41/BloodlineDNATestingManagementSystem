@page "/staff/results"
@using Data.Entities
@using Microsoft.AspNetCore.Authorization
@using global::Services.Interfaces
@inject IResultService ResultService
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Manager,Staff")]

<PageTitle>Result Management</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">Result Management</h1>
        <a href="/staff/results/create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Create New Result
        </a>
    </div>

    @if (allResults is null)
    {
        <p><em>Loading results...</em></p>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Result ID</th>
                                <th>Customer</th>
                                <th>Service</th>
                                <th>Report Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in allResults)
                            {
                                <tr>
                                    <td><strong>@result.Id.ToString("D6")</strong></td>
                                    <td>@result.User?.FullName</td>
                                    <td>@result.Service?.ServiceName</td>
                                    <td>@result.CreatedAt.ToString("g")</td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="/staff/results/edit/@result.Id" class="btn btn-outline-secondary">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button class="btn btn-outline-danger" @onclick="() => DeleteResult(result.Id)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Result>? allResults;

    protected override async Task OnInitializedAsync()
    {
        await LoadResults();
    }

    private async Task LoadResults()
    {
        var resultList = await ResultService.GetAllResultsAsync();
        if (resultList is not null)
        {
            allResults = resultList.ToList();
        }
    }

    private async Task DeleteResult(int resultId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this result?");
        if (confirmed)
        {
            await ResultService.DeleteResultAsync(resultId);
            await LoadResults();
            StateHasChanged();
        }
    }
}