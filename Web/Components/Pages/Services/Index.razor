@page "/services"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components
@using Data.Entities
@inject global::Services.Interfaces.IServiceService ServiceService
@inject IJSRuntime JSRuntime

<PageTitle>DNA Testing Services</PageTitle>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="display-4 text-primary">Our DNA Testing Services</h1>
                <div class="input-group" style="max-width: 300px;">
                    <button class="btn btn-outline-primary" type="button">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Filter Services</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Price Range</label>
                        <select class="form-select" @bind="selectedPriceRange" @bind:after="ApplyFilters">
                            <option value="">All Prices</option>
                            <option value="0-100">$0 - $100</option>
                            <option value="100-300">$100 - $300</option>
                            <option value="300-500">$300 - $500</option>
                            <option value="500+">$500+</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Duration</label>
                        <select class="form-select" @bind="selectedDuration" @bind:after="ApplyFilters">
                            <option value="">All Durations</option>
                            <option value="1-2 weeks">1-2 weeks</option>
                            <option value="3-4 weeks">3-4 weeks</option>
                            <option value="1-2 months">1-2 months</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="row">
                @if (filteredServices?.Any() == true)
                {
                    @foreach (var service in filteredServices)
                    {
                        <div class="col-lg-6 col-xl-4 mb-4">
                            <div class="card h-100 shadow-sm service-card">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <h5 class="card-title text-primary">@service.ServiceName</h5>
                                        <span class="badge bg-success fs-6">$@service.Price.ToString("F2")</span>
                                    </div>

                                    <p class="card-text text-muted flex-grow-1">
                                        @(service.Description.Length > 120 ? service.Description.Substring(0, 120) + "..." : service.Description)
                                    </p>

                                    <div class="mb-3">
                                        <small class="text-muted">
                                            <i class="fas fa-clock me-1"></i>
                                            Duration: @service.Duration
                                        </small>
                                    </div>

                                    <div class="d-flex gap-2 mt-auto">
                                        <a href="/services/@service.Id" class="btn btn-outline-primary flex-fill">
                                            View Details
                                        </a>
                                        <a href="/services/@service.Id/book" class="btn btn-primary flex-fill">
                                            Book Now
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="text-center py-5">
                            <i class="fas fa-search fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No services found</h4>
                            <p class="text-muted">Try adjusting your search criteria</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .service-card {
        transition: transform 0.2s ease-in-out;
    }

        .service-card:hover {
            transform: translateY(-5px);
        }
</style>

@code {
    private List<Service> services = new();
    private List<Service> filteredServices = new();
    private string selectedPriceRange = "";
    private string selectedDuration = "";

    protected override async Task OnInitializedAsync()
    {
        // Load services from your service/repository
        await LoadServices();
        filteredServices = services.ToList();
    }

    private async Task LoadServices()
    {
        services = await ServiceService.GetAllAsync();
    }

    private void FilterServices()
    {
        var originalCount = services.Count;
        filteredServices = services.Where(s =>
            (string.IsNullOrEmpty(selectedPriceRange) || IsInPriceRange(s.Price, selectedPriceRange)) &&
            (string.IsNullOrEmpty(selectedDuration) || IsInDurationRange(s.Duration, selectedDuration))
        ).ToList();

        // Debug: Log filter results
        Console.WriteLine($"Original services: {originalCount}");
        Console.WriteLine($"Filtered services: {filteredServices.Count}");
        Console.WriteLine($"Price Range: '{selectedPriceRange}'");
        Console.WriteLine($"Duration: '{selectedDuration}'");

        foreach (var service in filteredServices)
        {
            Console.WriteLine($"Service: {service.ServiceName}, Price: {service.Price}, Duration: {service.Duration}");
        }

        StateHasChanged(); // Force UI update
    }

    private bool IsInPriceRange(decimal price, string range)
    {
        return range switch
        {
            "0-100" => price <= 100,
            "100-300" => price > 100 && price <= 300,
            "300-500" => price > 300 && price <= 500,
            "500+" => price > 500,
            _ => true
        };
    }

    private bool IsInDurationRange(string serviceDuration, string selectedDuration)
    {
        if (string.IsNullOrEmpty(selectedDuration) || string.IsNullOrEmpty(serviceDuration))
            return string.IsNullOrEmpty(selectedDuration);

        var normalizedServiceDuration = serviceDuration.ToLowerInvariant().Trim();
        var normalizedSelectedDuration = selectedDuration.ToLowerInvariant().Trim();

        Console.WriteLine($"Comparing duration: '{normalizedServiceDuration}' with filter: '{normalizedSelectedDuration}'");

        return selectedDuration switch
        {
            "1-2 weeks" => normalizedServiceDuration.Contains("1-2") && normalizedServiceDuration.Contains("week"),
            "3-4 weeks" => normalizedServiceDuration.Contains("3-4") && normalizedServiceDuration.Contains("week") ||
                          normalizedServiceDuration.Contains("4-6") && normalizedServiceDuration.Contains("week"),
            "1-2 months" => normalizedServiceDuration.Contains("month") &&
                           (normalizedServiceDuration.Contains("1-2") || normalizedServiceDuration.Contains("1") || normalizedServiceDuration.Contains("2")),
            _ => normalizedServiceDuration.Contains(normalizedSelectedDuration)
        };
    }

    private void ApplyFilters()
    {
        FilterServices();
    }

    private void ClearFilters()
    {
        selectedPriceRange = "";
        selectedDuration = "";
        FilterServices();
    }
}