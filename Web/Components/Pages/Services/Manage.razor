@page "/admin/feedback"
@using Microsoft.EntityFrameworkCore
@using Data.Entities
@using Data.Enum
@using Microsoft.AspNetCore.Authorization
@inject Data.AppDbContext DbContext
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Manage Feedback</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">Manage User Feedback</h1>
        <div class="d-flex gap-2">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Search feedback..."
                       @bind="searchTerm" @oninput="FilterFeedback" />
                <button class="btn btn-outline-secondary">
                    <i class="fas fa-search"></i>
                </button>
            </div>
            <select class="form-select" style="width: auto;" @bind="SelectedStatus">
                <option value="">All Status</option>
                @foreach (var status in Enum.GetValues<FeedbackStatus>())
                {
                    <option value="@status">@status</option>
                }
            </select>
            <select class="form-select" style="width: auto;" @bind="SelectedType">
                <option value="">All Types</option>
                @foreach (var type in Enum.GetValues<FeedbackType>())
                {
                    <option value="@type">@type</option>
                }
            </select>
        </div>
    </div>

    @if (filteredFeedback == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!filteredFeedback.Any())
    {
        <div class="alert alert-info">
            No feedback found matching the current filters.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>User</th>
                        <th>Type</th>
                        <th>Message</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var feedback in filteredFeedback)
                    {
                        <tr>
                            <td>@feedback.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>@feedback.User?.Email</td>
                            <td>
                                <span class="badge @GetFeedbackTypeBadgeClass(feedback.Type)">
                                    @feedback.Type
                                </span>
                            </td>
                            <td>@(feedback.Message.Length > 50 ? feedback.Message[..50] + "..." : feedback.Message)</td>
                            <td>
                                <select class="form-select form-select-sm"
                                        @onchange="async (e) => await UpdateStatus(feedback, e.Value.ToString())">
                                    @foreach (var status in Enum.GetValues<FeedbackStatus>())
                                    {
                                        <option value="@status" selected="@(status == feedback.Status)">
                                            @status
                                        </option>
                                    }
                                </select>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary"
                                            @onclick="() => ViewDetails(feedback)">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button class="btn btn-outline-danger"
                                            @onclick="() => DeleteFeedback(feedback)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Feedback>? feedback;
    private List<Feedback>? filteredFeedback;
    private string searchTerm = "";
    private string selectedStatus = "";
    private string selectedType = "";

    public string SelectedStatus
    {
        get => selectedStatus;
        set
        {
            selectedStatus = value;
            FilterFeedback();
        }
    }

    public string SelectedType
    {
        get => selectedType;
        set
        {
            selectedType = value;
            FilterFeedback();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadFeedback();
    }

    private async Task LoadFeedback()
    {
        feedback = await DbContext.Feedbacks
            .Include(f => f.User)
            .OrderByDescending(f => f.CreatedAt)
            .ToListAsync();
        FilterFeedback();
    }

    private void FilterFeedback()
    {
        if (feedback == null) return;

        filteredFeedback = feedback.Where(f =>
            (string.IsNullOrEmpty(selectedStatus) || f.Status.ToString() == selectedStatus) &&
            (string.IsNullOrEmpty(selectedType) || f.Type.ToString() == selectedType) &&
            (string.IsNullOrEmpty(searchTerm) ||
             f.Message.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             f.User?.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true)
        ).ToList();
    }

    private string GetFeedbackTypeBadgeClass(FeedbackType type) => type switch
    {
        FeedbackType.Service => "bg-primary",
        FeedbackType.Appointment => "bg-info",
        FeedbackType.General => "bg-secondary",
        _ => "bg-secondary"
    };

    private async Task UpdateStatus(Feedback feedback, string newStatus)
    {
        if (Enum.TryParse<FeedbackStatus>(newStatus, out var status))
        {
            feedback.Status = status;
            await DbContext.SaveChangesAsync();
            await JSRuntime.InvokeVoidAsync("alert", "Status updated successfully");
        }
    }

    private async Task ViewDetails(Feedback feedback)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"Feedback Details:\n\nUser: {feedback.User?.Email}\nType: {feedback.Type}\nStatus: {feedback.Status}\nDate: {feedback.CreatedAt}\n\nMessage:\n{feedback.Message}");
    }

    private async Task DeleteFeedback(Feedback feedback)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this feedback?");
        if (confirmed)
        {
            DbContext.Feedbacks.Remove(feedback);
            await DbContext.SaveChangesAsync();
            await LoadFeedback();
            await JSRuntime.InvokeVoidAsync("alert", "Feedback deleted successfully");
        }
    }
}