@page "/account/addresses"
@using Data.Entities
@using Data.Enum
@using Microsoft.EntityFrameworkCore;
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Customer")]
@inject IJSRuntime JSRuntime
@inject Data.AppDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<User> UserManager

<PageTitle>My Addresses</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2><i class="fas fa-home me-2"></i>My Addresses</h2>
                    <p class="text-muted mb-0">Manage your home addresses for sample collection and delivery</p>
                </div>
                <button class="btn btn-primary" @onclick="ShowAddAddressModal">
                    <i class="fas fa-plus me-2"></i>Add Address
                </button>
            </div>

            @if (addresses?.Any() == true)
            {
                <div class="row">
                    @foreach (var address in addresses)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <h5 class="card-title">
                                            <i class="fas fa-home me-2"></i>
                                            Home Address
                                        </h5>
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <button class="dropdown-item" @onclick="() => EditAddress(address)">
                                                        <i class="fas fa-edit me-2"></i>Edit
                                                    </button>
                                                </li>
                                                <li>
                                                    <button class="dropdown-item text-danger" @onclick="() => DeleteAddress(address.Id)">
                                                        <i class="fas fa-trash me-2"></i>Delete
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div class="address-details">
                                        <p class="mb-2"><strong>@address.Street</strong></p>
                                        @if (!string.IsNullOrEmpty(address.Ward))
                                        {
                                            <p class="mb-1 text-muted">Ward: @address.Ward</p>
                                        }
                                        <p class="mb-1 text-muted">District: @address.District</p>
                                        <p class="mb-1 text-muted">@address.City, @address.Province</p>
                                        <p class="mb-2"><strong>@address.ZipCode</strong></p>

                                        @if (!string.IsNullOrEmpty(address.Notes))
                                        {
                                            <div class="mt-2 p-2 bg-light rounded">
                                                <small class="text-muted">
                                                    <i class="fas fa-sticky-note me-1"></i>
                                                    @address.Notes
                                                </small>
                                            </div>
                                        }
                                    </div>

                                    
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-home fa-3x text-muted mb-3"></i>
                    <h4>No addresses found</h4>
                    <p class="text-muted">Add your home address to enable sample collection and delivery services.</p>
                    <button class="btn btn-primary btn-lg" @onclick="ShowAddAddressModal">
                        <i class="fas fa-plus me-2"></i>Add Your First Address
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add/Edit Address Modal -->
<div class="modal fade" id="addressModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-home me-2"></i>
                    @(isEditing ? "Edit Home Address" : "Add Home Address")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <EditForm Model="currentAddress" OnValidSubmit="SaveAddress">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        This address will be used for sample collection and delivery services.
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Street Address *</label>
                        <InputText @bind-Value="currentAddress.Street" class="form-control" placeholder="Enter your street address" />
                        <ValidationMessage For="@(() => currentAddress.Street)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Ward</label>
                        <InputText @bind-Value="currentAddress.Ward" class="form-control" placeholder="Enter ward (optional)" />
                        <ValidationMessage For="@(() => currentAddress.Ward)" class="text-danger" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">District *</label>
                            <InputText @bind-Value="currentAddress.District" class="form-control" placeholder="Enter district" />
                            <ValidationMessage For="@(() => currentAddress.District)" class="text-danger" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">City *</label>
                            <InputText @bind-Value="currentAddress.City" class="form-control" placeholder="Enter city" />
                            <ValidationMessage For="@(() => currentAddress.City)" class="text-danger" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Province *</label>
                            <InputText @bind-Value="currentAddress.Province" class="form-control" placeholder="Enter province" />
                            <ValidationMessage For="@(() => currentAddress.Province)" class="text-danger" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Zip Code *</label>
                            <InputText @bind-Value="currentAddress.ZipCode" class="form-control" placeholder="Enter zip code" />
                            <ValidationMessage For="@(() => currentAddress.ZipCode)" class="text-danger" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Additional Notes</label>
                        <InputTextArea @bind-Value="currentAddress.Notes" class="form-control" rows="3"
                                       placeholder="Any special instructions for delivery or collection (e.g., apartment number, gate code, etc.)" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="fas fa-save me-2"></i>
                        @(isEditing ? "Update Address" : "Add Address")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private List<Address>? addresses;
    private Address currentAddress = new();
    private bool isEditing = false;
    private bool isSaving = false;
    private string? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        await GetCurrentUserId();
        await LoadAddresses();
    }

    private async Task GetCurrentUserId()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = UserManager.GetUserId(authState.User);
    }

    private async Task LoadAddresses()
    {
        if (!string.IsNullOrEmpty(currentUserId))
        {
            addresses = await DbContext.Addresses
                .Where(a => a.UserId == currentUserId && a.LocationType == LocationType.Home)
                .OrderByDescending(a => a.Id)
                .ToListAsync();
        }
    }

    private async Task ShowAddAddressModal()
    {
        currentAddress = new Address
            {
                LocationType = LocationType.Home,
                UserId = currentUserId ?? "",
                IsDeleted = false
            };
        isEditing = false;
        await JSRuntime.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('addressModal')).show()");
    }

    private async Task EditAddress(Address address)
    {
        currentAddress = new Address
            {
                Id = address.Id,
                Street = address.Street,
                Ward = address.Ward,
                District = address.District,
                City = address.City,
                Province = address.Province,
                ZipCode = address.ZipCode,
                LocationType = address.LocationType,
                Notes = address.Notes,
                UserId = address.UserId,
                IsDeleted = address.IsDeleted
            };
        isEditing = true;
        await JSRuntime.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('addressModal')).show()");
    }

    private async Task SaveAddress()
    {
        isSaving = true;
        try
        {
            if (isEditing)
            {
                var existingAddress = await DbContext.Addresses.FindAsync(currentAddress.Id);
                if (existingAddress != null)
                {
                    existingAddress.Street = currentAddress.Street;
                    existingAddress.Ward = currentAddress.Ward;
                    existingAddress.District = currentAddress.District;
                    existingAddress.City = currentAddress.City;
                    existingAddress.Province = currentAddress.Province;
                    existingAddress.ZipCode = currentAddress.ZipCode;
                    existingAddress.Notes = currentAddress.Notes;
                }
            }
            else
            {
                currentAddress.UserId = currentUserId ?? "";
                currentAddress.LocationType = LocationType.Home; // Force Home type for customers
                currentAddress.IsDeleted = false;
                DbContext.Addresses.Add(currentAddress);
            }

            await DbContext.SaveChangesAsync();
            await LoadAddresses();
            await JSRuntime.InvokeVoidAsync("eval", "bootstrap.Modal.getInstance(document.getElementById('addressModal')).hide()");
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("alert", isEditing ? "Address updated successfully!" : "Address added successfully!");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving address: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteAddress(int addressId)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this address?"))
        {
            try
            {
                var address = await DbContext.Addresses.FindAsync(addressId);
                if (address != null)
                {
                    DbContext.Addresses.Remove(address);
                    await DbContext.SaveChangesAsync();
                    await LoadAddresses();
                    StateHasChanged();
                    await JSRuntime.InvokeVoidAsync("alert", "Address deleted successfully!");
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error deleting address: {ex.Message}");
            }
        }
    }
}
