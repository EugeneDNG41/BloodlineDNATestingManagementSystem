@page "/results"
@using Data.Entities
@using Data.Enum
@using Web.Components.Account
@using Microsoft.AspNetCore.Authorization
@using global::Services.Interfaces
@inject IdentityUserAccessor UserAccessor
@inject IResultService ResultService
@attribute [Authorize(Roles = "Customer")]

<PageTitle>My Test Results</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">My Test Results</h1>
    </div>

    @if (results is null)
    {
        <p><em>Loading...</em></p>
    }
    else if (results.Any())
    {
        <div class="row">
            @foreach (var result in results)
            {
                <div class="col-lg-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title text-primary">@result.Summary</h5>
                                    <span class="badge @GetAnalysisTypeBadgeClass(result.Type)">
                                        @result.Type
                                    </span>
                                </div>
                                <small class="text-muted">@result.CreatedAt.ToString("MMM dd, yyyy")</small>
                            </div>

                            <p class="text-muted">
                                <strong>Service:</strong> @result.Service.ServiceName
                            </p>

                            <a href="/results/@result.Id" class="btn btn-primary mt-auto">
                                <i class="fas fa-eye me-1"></i>View Full Report
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-file-medical fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">No results available</h4>
            <p class="text-muted">Your test results will appear here once processing is complete.</p>
            <a href="/appointments" class="btn btn-primary">View My Appointments</a>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    private User user = default!;
    private List<Result> results = new();

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        var resultList = await ResultService.GetResultsByUserIdAsync(user.Id);
        if (resultList is not null)
        {
            results = resultList.ToList();
        }
    }

    private string GetAnalysisTypeBadgeClass(AnalysisType type) => type switch
    {
        AnalysisType.Paternity or AnalysisType.Maternity => "bg-primary",
        AnalysisType.EthnicityEstimate => "bg-success",
        AnalysisType.GeneticHealthRisk => "bg-warning",
        _ => "bg-secondary"
    };
}