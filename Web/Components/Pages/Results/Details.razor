@page "/results/{id:int}"
@using Data.Entities
@using Data.Enum
@using Microsoft.AspNetCore.Authorization
@using Web.Components.Account
@using global::Services.Interfaces
@inject IdentityUserAccessor UserAccessor
@inject IResultService ResultService
@attribute [Authorize(Roles = "Customer")]

<PageTitle>Test Result Details</PageTitle>

@if (result is null)
{
    @if (isLoading)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
            <h4>Result Not Found</h4>
            <p class="text-muted">The requested result could not be found or you do not have permission to view it.</p>
            <a href="/results" class="btn btn-primary">Back to My Results</a>
        </div>
    }
}
else
{
    <div class="container py-4">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/results">Results</a></li>
                <li class="breadcrumb-item active">@result.Summary</li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3 class="mb-0">@result.Summary</h3>
                        <span class="badge @GetAnalysisTypeBadgeClass(result.Type) fs-6">@result.Type</span>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h6>Test Information</h6>
                                <p class="mb-1"><strong>Service:</strong> @result.Service.ServiceName</p>
                                <p class="mb-0"><strong>Report Date:</strong> @result.CreatedAt.ToString("MMMM dd, yyyy")</p>
                            </div>
                            <div class="col-md-6">
                                <h6>Sample Information</h6>
                                <p class="mb-1"><strong>Samples Analyzed:</strong> @result.Samples.Count</p>
                                <p class="mb-0"><strong>Collection Method:</strong> @(result.Samples.FirstOrDefault()?.CollectionMethod.ToString() ?? "N/A")</p>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h6>Test Results</h6>
                            <div class="bg-light p-4 rounded">
                                @if (result.Type == AnalysisType.Paternity)
                                {
                                    <div class="text-center mb-3">
                                        <div class="h2 text-success">99.9%</div>
                                        <p class="mb-0">Probability of Paternity</p>
                                    </div>
                                    <div class="alert alert-success">
                                        <strong>Conclusion:</strong> The alleged father is not excluded as the biological father of the tested child.
                                    </div>
                                }
                                else if (result.Type == AnalysisType.EthnicityEstimate)
                                {
                                    <h6>Ethnicity Breakdown</h6>
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span>European</span> <span>45.2%</span>
                                        </div>
                                        <div class="progress mb-2">
                                            <div class="progress-bar bg-primary" style="width: 45.2%"></div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted">@result.Notes</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header"><h5 class="mb-0">Actions</h5></div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary"><i class="fas fa-download me-2"></i>Download PDF Report</button>
                            <a href="/results" class="btn btn-secondary"><i class="fas fa-arrow-left me-2"></i>Back to Results</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private User user = default!;
    private Result? result;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        result = await ResultService.GetResultDetailsAsync(Id, user.Id);
        isLoading = false;
    }

    private string GetAnalysisTypeBadgeClass(AnalysisType type) => type switch
    {
        AnalysisType.Paternity or AnalysisType.Maternity => "bg-primary",
        AnalysisType.EthnicityEstimate => "bg-success",
        AnalysisType.GeneticHealthRisk => "bg-warning",
        _ => "bg-secondary"
    };
}