@page "/appointments"
@using Microsoft.EntityFrameworkCore
@using Data.Entities
@using Data.Enum
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims;
@using Web.Components.Account
@using global::Services.Interfaces
@inject IdentityUserAccessor UserAccessor
@inject Data.AppDbContext DbContext
@attribute [Authorize(Roles = "Customer")]
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAppointmentService AppointmentService

<PageTitle>My Appointments</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">My Appointments</h1>
        <a href="/services" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Book New Appointment
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-md-8">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Search appointments..." @bind="searchTerm" @oninput="FilterAppointments">
                <button class="btn btn-outline-secondary" type="button" @onclick="FilterAppointments">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
        <div class="col-md-4">
            <select class="form-select" @bind="SelectedStatus">
                <option value="">All Status</option>
                <option value="Scheduled">Scheduled</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
                <option value="NoShow">No Show</option>
            </select>
        </div>
    </div>

    @if (filteredAppointments?.Any() == true)
    {
        <div class="row">
            @foreach (var appointment in filteredAppointments)
            {
                <div class="col-lg-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title text-primary">@appointment.Service.ServiceName</h5>
                                <span class="badge @GetStatusBadgeClass(appointment.Status)">
                                    @appointment.Status.ToString()
                                </span>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-calendar text-muted me-2"></i>
                                    <span>@appointment.ScheduledAt.ToString("MMMM dd, yyyy")</span>
                                </div>
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-clock text-muted me-2"></i>
                                    <span>@appointment.ScheduledAt.ToString("hh:mm tt")</span>
                                </div>
                                <div class="d-flex align-items-start mb-2">
                                    <i class="fas fa-map-marker-alt text-muted me-2 mt-1"></i>
                                    <span>@appointment.Address.Street, @appointment.Address.Province</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(appointment.Description))
                            {
                                <p class="text-muted small">@appointment.Description</p>
                            }

                            <div class="d-flex gap-2 mt-auto">
                                <a href="/appointments/@appointment.Id" class="btn btn-outline-primary btn-sm">
                                    View Details
                                </a>
                                @if (appointment.Status == AppointmentStatus.Scheduled)
                                {
                                    <button class="btn btn-outline-warning btn-sm" @onclick="() => ShowRescheduleModal(appointment.Id)">
                                        Reschedule
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => CancelAppointment(appointment.Id)">
                                        Cancel
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">No appointments found</h4>
            <p class="text-muted">Book your first DNA testing appointment to get started</p>
            <a href="/services" class="btn btn-primary">Browse Services</a>
        </div>
    }
</div>

@if (isRescheduleModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Reschedule Appointment</h5>
                    <button type="button" class="btn-close" @onclick="CloseRescheduleModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="newDate" class="form-label">New Date <span class="text-danger">*</span></label>
                        <InputDate id="newDate" class="form-control"
                                   @bind-Value="RescheduleModel.Date"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-3">
                        <label for="newTime" class="form-label">New Time <span class="text-danger">*</span></label>
                        <InputSelect id="newTime" class="form-select" @bind-Value="RescheduleModel.Time">
                            <option value="">Select time...</option>
                            @foreach (var timeSlot in availableTimeSlots)
                            {
                                <option value="@timeSlot">@timeSlot</option>
                            }
                        </InputSelect>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseRescheduleModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmReschedule">Confirm</button>
                </div>
            </div>
        </div>
    </div>
}






@code {

    private User user = default!;
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    private List<Appointment> appointments = new();
    private List<Appointment> filteredAppointments = new();
    private string searchTerm = "";

    private string selectedStatus = "";
    public string SelectedStatus
    {
        get => selectedStatus;
        set
        {
            if (selectedStatus != value)
            {
                selectedStatus = value;
                FilterAppointments();
            }
        }
    }

    private RescheduleAppointmentModel RescheduleModel = new();
    private bool isRescheduleModalVisible = false;
    private List<string> availableTimeSlots = new()
{
    "09:00 AM", "10:00 AM", "11:00 AM", "12:00 PM",
    "01:00 PM", "02:00 PM", "03:00 PM", "04:00 PM", "05:00 PM"
};


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity is { IsAuthenticated: true })
        {
            var userId = userPrincipal.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            user = await DbContext.Users.FirstOrDefaultAsync(u => u.Id == userId);
        }

        await LoadAppointments();
        FilterAppointments();
    }


    private async Task LoadAppointments()
    {

        appointments = await AppointmentService.GetAppointmentsByUserAsync(user.Id);
        appointments = appointments
            .Where(a => !a.IsDeleted)
            .OrderByDescending(a => a.ScheduledAt)
            .ToList();
    }

    private void FilterAppointments()
    {
        filteredAppointments = appointments.Where(a =>
            (string.IsNullOrEmpty(searchTerm) ||
             a.Service.ServiceName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             a.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(selectedStatus) || a.Status.ToString() == selectedStatus)
        ).ToList();
    }

    private string GetStatusBadgeClass(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Scheduled => "bg-primary",
            AppointmentStatus.Completed => "bg-success",
            AppointmentStatus.Cancelled => "bg-danger",
            AppointmentStatus.NoShow => "bg-warning",
            _ => "bg-secondary"
        };
    }

    private async Task CancelAppointment(int appointmentId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to cancel this appointment?");
        if (confirmed)
        {
            var success = await AppointmentService.CancelAppointmentAsync(appointmentId, user.Id, "Cancelled by customer");
            if (success)
            {
                await LoadAppointments();
                FilterAppointments();
            }
        }
    }

    private void ShowRescheduleModal(int appointmentId)
    {
        var appointment = appointments.FirstOrDefault(a => a.Id == appointmentId);
        if (appointment != null)
        {
            RescheduleModel = new RescheduleAppointmentModel
                {
                    AppointmentId = appointment.Id,
                    Date = null,
                    Time = "" // Mặc định không chọn time
                };
            isRescheduleModalVisible = true;
        }
    }

    private void CloseRescheduleModal()
    {
        isRescheduleModalVisible = false;
        RescheduleModel = new(); // Reset model
    }


    private async Task ConfirmReschedule()
{
    if (string.IsNullOrWhiteSpace(RescheduleModel.Time))
    {
        await JSRuntime.InvokeVoidAsync("alert", "Please select a time.");
        return;
    }

    var convertedTime = ConvertTo24Hour(RescheduleModel.Time);

    var success = await AppointmentService.RescheduleAppointmentAsync(
        RescheduleModel.AppointmentId,
        RescheduleModel.Date.Value,
        convertedTime
    );

    if (success)
    {
        isRescheduleModalVisible = false;
        await LoadAppointments();
        FilterAppointments();
        await JSRuntime.InvokeVoidAsync("alert", "Appointment rescheduled successfully.");
    }
    else
    {
        await JSRuntime.InvokeVoidAsync("alert", "Rescheduling failed. Time slot may be taken.");
    }
}



    private string ConvertTo24Hour(string time12Hour)
    {
        if (DateTime.TryParse(time12Hour, out DateTime dateTime))
        {
            return dateTime.ToString("HH:mm");
        }
        return "09:00";
    }


    public class RescheduleAppointmentModel
    {
        public int AppointmentId { get; set; }
        public DateTime? Date { get; set; } 
        public string Time { get; set; } = "";
    }
}
