@page "/appointments/{appointmentId:int}/reschedule" 
@inject NavigationManager NavigationManager
@inject IAppointmentService AppointmentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using System.ComponentModel.DataAnnotations
@using global::Services.Interfaces
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime

<PageTitle>Reschedule Appointment</PageTitle>

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/appointments">Appointments</a></li>
            <li class="breadcrumb-item active" aria-current="page">Reschedule</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h3 class="mb-0"><i class="fas fa-calendar-alt text-warning me-2"></i> Reschedule Appointment</h3>
                </div>
                <div class="card-body">
                    @if (isSuccess)
                    {
                        <div class="alert alert-success">Your appointment has been rescheduled successfully.</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    <EditForm Model="rescheduleModel" OnValidSubmit="HandleReschedule" FormName="Reschedule">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label">New Date <span class="text-danger">*</span></label>
                                <InputDate class="form-control" @bind-Value="rescheduleModel.ScheduledDate"
                                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <ValidationMessage For="@(() => rescheduleModel.ScheduledDate)" class="text-danger" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">New Time <span class="text-danger">*</span></label>
                                <InputSelect class="form-select" @bind-Value="rescheduleModel.ScheduledTime">
                                    <option value="">Select time...</option>
                                    @foreach (var timeSlot in availableTimeSlots)
                                    {
                                        <option value="@timeSlot">@timeSlot</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => rescheduleModel.ScheduledTime)" class="text-danger" />
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fas fa-sync-alt me-2"></i>Confirm Reschedule
                            </button>
                            <button class="btn btn-secondary" @onclick="BackToIndex" type="button">
                                <i class="fas fa-times me-2"></i>Cancel
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int appointmentId { get; set; }

    private RescheduleModel rescheduleModel = new();
    private bool isSuccess = false;
    private bool isSubmitting = false;
    private string errorMessage = string.Empty;

    private List<string> availableTimeSlots = new()
    {
        "09:00 AM", "10:00 AM", "11:00 AM", "12:00 PM",
        "01:00 PM", "02:00 PM", "03:00 PM", "04:00 PM", "05:00 PM"
    };

    private async Task HandleReschedule()
    {
        isSubmitting = true;
        errorMessage = string.Empty;

        var time24h = ConvertTo24Hour(rescheduleModel.ScheduledTime);

        var success = await AppointmentService.RescheduleAppointmentAsync(
            appointmentId,
            rescheduleModel.ScheduledDate!.Value,
            time24h
        );

        if (success)
        {
            isSuccess = true;
            await Task.Delay(1000);
            await JSRuntime.InvokeVoidAsync("alert", "Appointment rescheduled successfully.");
            NavigationManager.NavigateTo("/appointments");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Rescheduling failed. Time slot may be taken.");
        }

        isSubmitting = false;
    }

    private void BackToIndex() => NavigationManager.NavigateTo("/appointments");

    private string ConvertTo24Hour(string time12Hour)
    {
        if (DateTime.TryParse(time12Hour, out DateTime dateTime))
        {
            return dateTime.ToString("HH:mm");
        }
        return "09:00";
    }

    public class RescheduleModel
    {
        [Required(ErrorMessage = "Date is required")]
        public DateTime? ScheduledDate { get; set; } 

        [Required(ErrorMessage = "Time is required")]
        public string ScheduledTime { get; set; } = "";
    }
}
