@page "/services/{serviceId:int}/book"
@page "/appointments/book"
@using Microsoft.EntityFrameworkCore
@using Data.Entities
@using Data.Enum
@using System.ComponentModel.DataAnnotations;
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims;
@using Web.Components.Account
@inject IdentityUserAccessor UserAccessor
@inject Data.AppDbContext DbContext
@attribute [Authorize(Roles = "Customer")]
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Book Appointment</PageTitle>

<div class="container py-4">
    @if (selectedService != null)
    {
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/services">Services</a></li>
                <li class="breadcrumb-item"><a href="/services/@selectedService.Id">@selectedService.ServiceName</a></li>
                <li class="breadcrumb-item active">Book Appointment</li>
            </ol>
        </nav>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h3 class="mb-0">
                        <i class="fas fa-calendar-plus text-primary me-2"></i>
                        Book Your Appointment
                    </h3>
                </div>
                <div class="card-body">
                    <EditForm Model="appointmentModel" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />

                        @if (ServiceId == null)
                        {
                            <div class="mb-4">
                                <label for="serviceSelect" class="form-label">Select Service <span class="text-danger">*</span></label>
                                <InputSelect id="serviceSelect" class="form-select" @bind-Value="appointmentModel.ServiceId" @onchange="OnServiceChanged">
                                    <option value="">Choose a service...</option>
                                    @foreach (var service in availableServices)
                                    {
                                        <option value="@service.Id">@service.ServiceName - $@service.Price.ToString("F2")</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => appointmentModel.ServiceId)" class="text-danger" />
                            </div>
                        }

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label for="appointmentDate" class="form-label">Preferred Date <span class="text-danger">*</span></label>
                                <InputDate id="appointmentDate" class="form-control" @bind-Value="appointmentModel.ScheduledDate" 
                                         min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <ValidationMessage For="@(() => appointmentModel.ScheduledDate)" class="text-danger" />
                            </div>
                            <div class="col-md-6">
                                <label for="appointmentTime" class="form-label">Preferred Time <span class="text-danger">*</span></label>
                                <InputSelect id="appointmentTime" class="form-select" @bind-Value="appointmentModel.ScheduledTime">
                                    <option value="">Select time...</option>
                                    @foreach (var timeSlot in availableTimeSlots)
                                    {
                                        <option value="@timeSlot">@timeSlot</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => appointmentModel.ScheduledTime)" class="text-danger" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="description" class="form-label">Additional Notes</label>
                            <InputTextArea id="description" class="form-control" @bind-Value="appointmentModel.Description" 
                                         placeholder="Any special requirements or notes for your appointment..." rows="3" />
                            <div class="form-text">Optional: Include any specific requirements or questions you have.</div>
                        </div>

                        <div class="mb-4">
                            <h5>Appointment Address</h5>
                            <div class="row">
                                <div class="col-md-6">
                                    <label for="street" class="form-label">Street Address <span class="text-danger">*</span></label>
                                    <InputText id="street" class="form-control" @bind-Value="appointmentModel.Street" 
                                             placeholder="123 Main Street" />
                                    <ValidationMessage For="@(() => appointmentModel.Street)" class="text-danger" />
                                </div>
                                <div class="col-md-6">
                                    <label for="city" class="form-label">City <span class="text-danger">*</span></label>
                                    <InputText id="city" class="form-control" @bind-Value="appointmentModel.City" 
                                             placeholder="City name" />
                                    <ValidationMessage For="@(() => appointmentModel.City)" class="text-danger" />
                                </div>
                            </div>
                            @* <div class="row mt-3"> *@
                            @*     <div class="col-md-4"> *@
                            @*         <label for="state" class="form-label">State <span class="text-danger">*</span></label> *@
                            @*         <InputText id="state" class="form-control" @bind-Value="appointmentModel.State"  *@
                            @*                  placeholder="State" /> *@
                            @*         <ValidationMessage For="@(() => appointmentModel.State)" class="text-danger" /> *@
                            @*     </div> *@
                            @*     <div class="col-md-4"> *@
                            @*         <label for="zipCode" class="form-label">ZIP Code <span class="text-danger">*</span></label> *@
                            @*         <InputText id="zipCode" class="form-control" @bind-Value="appointmentModel.ZipCode"  *@
                            @*                  placeholder="12345" /> *@
                            @*         <ValidationMessage For="@(() => appointmentModel.ZipCode)" class="text-danger" /> *@
                            @*     </div> *@
                            @*     <div class="col-md-4"> *@
                            @*         <label for="country" class="form-label">Country <span class="text-danger">*</span></label> *@
                            @*         <InputText id="country" class="form-control" @bind-Value="appointmentModel.Country"  *@
                            @*                  placeholder="United States" /> *@
                            @*         <ValidationMessage For="@(() => appointmentModel.Country)" class="text-danger" /> *@
                            @*     </div> *@
                            @* </div> *@
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fas fa-calendar-check me-2"></i>
                                Book Appointment
                            </button>
                            <a href="@(selectedService != null ? $"/services/{selectedService.Id}" : "/services")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Back
                            </a>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            @if (selectedService != null)
            {
                <div class="card shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header">
                        <h5 class="mb-0">Appointment Summary</h5>
                    </div>
                    <div class="card-body">
                        <h6 class="text-primary">@selectedService.ServiceName</h6>
                        <p class="text-muted small mb-3">@selectedService.Description</p>
                        
                        <div class="d-flex justify-content-between mb-2">
                            <span>Service Price:</span>
                            <strong class="text-success">$@selectedService.Price.ToString("F2")</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Processing Time:</span>
                            <span>@selectedService.Duration</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between">
                            <strong>Total:</strong>
                            <strong class="text-success">$@selectedService.Price.ToString("F2")</strong>
                        </div>

                        @if (appointmentModel.ScheduledDate.HasValue && !string.IsNullOrEmpty(appointmentModel.ScheduledTime))
                        {
                            <div class="mt-3 p-3 bg-light rounded">
                                <h6>Scheduled For:</h6>
                                <p class="mb-0">
                                    <i class="fas fa-calendar me-2"></i>
                                    @appointmentModel.ScheduledDate.Value.ToString("MMMM dd, yyyy")
                                </p>
                                <p class="mb-0">
                                    <i class="fas fa-clock me-2"></i>
                                    @appointmentModel.ScheduledTime
                                </p>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <h6><i class="fas fa-info-circle text-info me-2"></i>What to Expect</h6>
                    <ul class="small mb-0">
                        <li>Our technician will arrive at your specified address</li>
                        <li>Sample collection takes approximately 15-30 minutes</li>
                        <li>You'll receive a confirmation email with tracking information</li>
                        <li>Results will be available in your online portal</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private User user = default!;
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    [Parameter] public int? ServiceId { get; set; }
    
    private AppointmentBookingModel appointmentModel = new();
    private List<Service> availableServices = new();
    private Service? selectedService;
    private bool isSubmitting = false;
    
    private List<string> availableTimeSlots = new()
    {
        "09:00 AM", "10:00 AM", "11:00 AM", "12:00 PM",
        "01:00 PM", "02:00 PM", "03:00 PM", "04:00 PM", "05:00 PM"
    };

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        await LoadServices();
        
        if (ServiceId.HasValue)
        {
            selectedService = availableServices.FirstOrDefault(s => s.Id == ServiceId.Value);
            appointmentModel.ServiceId = ServiceId.Value;
        }
    }

    private async Task LoadServices()
    {
        availableServices = await DbContext.Services.ToListAsync();
    }

    private async Task OnServiceChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int serviceId))
        {
            selectedService = availableServices.FirstOrDefault(s => s.Id == serviceId);
        }
        else
        {
            selectedService = null;
        }
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        
        try
        {
            // Create address
            var address = new Address
            {
                Street = appointmentModel.Street,
                ZipCode = appointmentModel.ZipCode,
            };

            DbContext.Addresses.Add(address);
            await DbContext.SaveChangesAsync();

            // Create appointment
            var appointment = new Appointment
            {
                ScheduledAt = appointmentModel.ScheduledDate.Value.Date.Add(TimeSpan.Parse(ConvertTo24Hour(appointmentModel.ScheduledTime))),
                Description = appointmentModel.Description ?? "",
                Status = AppointmentStatus.Scheduled,
                AddressId = address.Id,
                UserId = user.Id,
                ServiceId = appointmentModel.ServiceId
            };

            DbContext.Appointments.Add(appointment);
            await DbContext.SaveChangesAsync();

            await JSRuntime.InvokeVoidAsync("alert", "Appointment booked successfully!");
            Navigation.NavigateTo("/appointments");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error booking appointment: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string ConvertTo24Hour(string time12Hour)
    {
        if (DateTime.TryParse(time12Hour, out DateTime dateTime))
        {
            return dateTime.ToString("HH:mm");
        }
        return "09:00";
    }

    public class AppointmentBookingModel
    {
        [Required(ErrorMessage = "Please select a service")]
        public int ServiceId { get; set; }

        [Required(ErrorMessage = "Please select a date")]
        public DateTime? ScheduledDate { get; set; }

        [Required(ErrorMessage = "Please select a time")]
        public string ScheduledTime { get; set; } = "";

        public string? Description { get; set; }

        [Required(ErrorMessage = "Street address is required")]
        public string Street { get; set; } = "";

        [Required(ErrorMessage = "City is required")]
        public string City { get; set; } = "";

        [Required(ErrorMessage = "State is required")]
        public string State { get; set; } = "";

        [Required(ErrorMessage = "ZIP code is required")]
        public string ZipCode { get; set; } = "";

        [Required(ErrorMessage = "Country is required")]
        public string Country { get; set; } = "United States";
    }
}
