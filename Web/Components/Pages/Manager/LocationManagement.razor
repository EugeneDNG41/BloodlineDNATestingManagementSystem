@page "/manager/locations"
@using Data.Entities
@using Data.Enum
@using Microsoft.EntityFrameworkCore;
@using System.ComponentModel.DataAnnotations;
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Manager,Admin")]
@inject IJSRuntime JSRuntime
@inject Data.AppDbContext DbContext

<PageTitle>Location Management</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-building me-2"></i>Location Management</h2>
                <button class="btn btn-primary" @onclick="ShowAddLocationModal">
                    <i class="fas fa-plus me-2"></i>Add Location
                </button>
            </div>

            <!-- Search and Filter -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <input type="text" class="form-control" @bind="searchTerm" @onkeypress="HandleKeyPress" placeholder="Search locations...">
                        </div>
                        <div class="col-md-2 mb-3">
                            <select class="form-select" @bind="selectedType">
                                <option value="">All Types</option>
                                <option value="Lab">Labs</option>
                                <option value="Clinic">Clinics</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <select class="form-select" @bind="selectedProvince">
                                <option value="">All Provinces</option>
                                @if (availableProvinces?.Any() == true)
                                {
                                    @foreach (var province in availableProvinces)
                                    {
                                        <option value="@province">@province</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <select class="form-select" @bind="selectedCity">
                                <option value="">All Cities</option>
                                @if (availableCities?.Any() == true)
                                {
                                    @foreach (var city in availableCities)
                                    {
                                        <option value="@city">@city</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-1 mb-3 d-flex align-items-end">
                            <button class="btn btn-outline-primary w-100" @onclick="FilterLocations">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Locations Table -->
            @if (filteredLocations?.Any() == true)
            {
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Address</th>
                                        <th>Location Details</th>
                                        <th>Opening Hours</th>
                                        <th>Appointments</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var location in filteredLocations)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-@(location.LocationType == LocationType.Lab ? "primary" : "success")">
                                                    <i class="fas fa-@(GetLocationIcon(location.LocationType)) me-1"></i>
                                                    @location.LocationType
                                                </span>
                                            </td>
                                            <td>
                                                <div>
                                                    <div class="fw-bold">@location.Street</div>
                                                    <small class="text-muted">@location.Ward, @location.District</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div>
                                                    <div><strong>City:</strong> @location.City</div>
                                                    <div><strong>Province:</strong> @location.Province</div>
                                                    <div><strong>Zip:</strong> @location.ZipCode</div>
                                                </div>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(location.OpeningHours))
                                                {
                                                    <span>@location.OpeningHours</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not specified</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@location.Appointments.Count</span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => EditLocation(location)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-info" @onclick="() => ViewAppointments(location.Id)">
                                                        <i class="fas fa-calendar"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteLocation(location.Id)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-building fa-3x text-muted mb-3"></i>
                    <h4>No locations found</h4>
                    <p class="text-muted">Add your first location to get started.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add/Edit Location Modal -->
<div class="modal fade" id="locationModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@(isEditing ? "Edit Location" : "Add Location")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <EditForm Model="currentLocation" OnValidSubmit="SaveLocation">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Location Type *</label>
                        <InputSelect @bind-Value="currentLocation.LocationType" class="form-select">
                            <option value="@LocationType.Lab">Lab</option>
                            <option value="@LocationType.Clinic">Clinic</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => currentLocation.LocationType)" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Street Address *</label>
                        <InputText @bind-Value="currentLocation.Street" class="form-control" />
                        <ValidationMessage For="@(() => currentLocation.Street)" />
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ward *</label>
                            <InputText @bind-Value="currentLocation.Ward" class="form-control" />
                            <ValidationMessage For="@(() => currentLocation.Ward)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">District *</label>
                            <InputText @bind-Value="currentLocation.District" class="form-control" />
                            <ValidationMessage For="@(() => currentLocation.District)" />
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">City *</label>
                            <InputText @bind-Value="currentLocation.City" class="form-control" />
                            <ValidationMessage For="@(() => currentLocation.City)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Province *</label>
                            <InputText @bind-Value="currentLocation.Province" class="form-control" />
                            <ValidationMessage For="@(() => currentLocation.Province)" />
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Zip Code *</label>
                        <InputText @bind-Value="currentLocation.ZipCode" class="form-control" />
                        <ValidationMessage For="@(() => currentLocation.ZipCode)" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Opening Hours</label>
                        <InputText @bind-Value="currentLocation.OpeningHours" class="form-control" placeholder="e.g., Mon-Fri: 8AM-6PM, Sat: 9AM-3PM" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <InputTextArea @bind-Value="currentLocation.Notes" class="form-control" rows="3" 
                                       placeholder="Additional information, special instructions, etc." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        @(isEditing ? "Update Location" : "Add Location")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private List<Address>? allLocations;
    private List<Address>? filteredLocations;
    private List<string>? availableProvinces;
    private List<string>? availableCities;
    private Address currentLocation = new();
    private bool isEditing = false;
    
    private string searchTerm = string.Empty;
    private string selectedType = string.Empty;
    private string selectedProvince = string.Empty;
    private string selectedCity = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadLocations();
        LoadFilterOptions();
        filteredLocations = allLocations;
    }

    private async Task LoadLocations()
    {
        allLocations = await DbContext.Addresses
            .Include(a => a.Appointments)
            .Where(a => a.LocationType == LocationType.Lab || a.LocationType == LocationType.Clinic)
            .OrderBy(a => a.LocationType)
            .ThenBy(a => a.Province)
            .ThenBy(a => a.City)
            .ToListAsync();
    }

    private void LoadFilterOptions()
    {
        if (allLocations?.Any() == true)
        {
            availableProvinces = allLocations
                .Select(l => l.Province)
                .Distinct()
                .OrderBy(p => p)
                .ToList();

            availableCities = allLocations
                .Select(l => l.City)
                .Distinct()
                .OrderBy(c => c)
                .ToList();
        }
    }

    private async Task FilterLocations()
    {
        if (allLocations == null) return;

        filteredLocations = allLocations.Where(location =>
        {
            var matchesSearch = string.IsNullOrEmpty(searchTerm) ||
                location.Street.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                location.Ward.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                location.District.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                location.City.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                location.Province.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);

            var matchesType = string.IsNullOrEmpty(selectedType) ||
                location.LocationType.ToString() == selectedType;

            var matchesProvince = string.IsNullOrEmpty(selectedProvince) ||
                location.Province.Equals(selectedProvince, StringComparison.OrdinalIgnoreCase);

            var matchesCity = string.IsNullOrEmpty(selectedCity) ||
                location.City.Equals(selectedCity, StringComparison.OrdinalIgnoreCase);

            return matchesSearch && matchesType && matchesProvince && matchesCity;
        }).ToList();

        StateHasChanged();
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await FilterLocations();
        }
    }

    private async Task ShowAddLocationModal()
    {
        currentLocation = new Address 
        { 
            LocationType = LocationType.Lab
        };
        isEditing = false;
        await JSRuntime.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('addressModal')).show()");
    }

    private async Task EditLocation(Address location)
    {
        currentLocation = new Address
        {
            Id = location.Id,
            Street = location.Street,
            Ward = location.Ward,
            District = location.District,
            City = location.City,
            Province = location.Province,
            ZipCode = location.ZipCode,
            LocationType = location.LocationType,
            OpeningHours = location.OpeningHours,
            Notes = location.Notes,
            UserId = location.UserId
        };
        isEditing = true;
        await JSRuntime.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('addressModal')).show()");
    }

    private async Task SaveLocation()
    {
        try
        {
            if (isEditing)
            {
                var existingLocation = await DbContext.Addresses.FindAsync(currentLocation.Id);
                if (existingLocation != null)
                {
                    existingLocation.Street = currentLocation.Street;
                    existingLocation.Ward = currentLocation.Ward;
                    existingLocation.District = currentLocation.District;
                    existingLocation.City = currentLocation.City;
                    existingLocation.Province = currentLocation.Province;
                    existingLocation.ZipCode = currentLocation.ZipCode;
                    existingLocation.LocationType = currentLocation.LocationType;
                    existingLocation.OpeningHours = currentLocation.OpeningHours;
                    existingLocation.Notes = currentLocation.Notes;
                }
            }
            else
            {
                DbContext.Addresses.Add(currentLocation);
            }

            await DbContext.SaveChangesAsync();
            await LoadLocations();
            LoadFilterOptions();
            await FilterLocations();
            await JSRuntime.InvokeVoidAsync("eval", "bootstrap.Modal.getInstance(document.getElementById('addressModal')).hide()");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving location: {ex.Message}");
        }
    }

    private async Task DeleteLocation(int locationId)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this location? This will also affect any associated appointments."))
        {
            try
            {
                var location = await DbContext.Addresses
                    .Include(a => a.Appointments)
                    .FirstOrDefaultAsync(a => a.Id == locationId);
                
                if (location != null)
                {
                    if (location.Appointments.Any())
                    {
                        var confirmDelete = await JSRuntime.InvokeAsync<bool>("confirm", 
                            $"This location has {location.Appointments.Count} associated appointments. Are you sure you want to delete it?");
                        
                        if (!confirmDelete) return;
                    }

                    DbContext.Addresses.Remove(location);
                    await DbContext.SaveChangesAsync();
                    await LoadLocations();
                    LoadFilterOptions();
                    await FilterLocations();
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error deleting location: {ex.Message}");
            }
        }
    }

    private void ViewAppointments(int locationId)
    {
        // Navigate to appointments filtered by location
        // NavigationManager.NavigateTo($"/manager/appointments?locationId={locationId}");
        JSRuntime.InvokeVoidAsync("alert", "Navigate to appointments for this location");
    }

    private string GetLocationIcon(LocationType locationType)
    {
        return locationType switch
        {
            LocationType.Lab => "flask",
            LocationType.Clinic => "clinic-medical",
            _ => "map-marker-alt"
        };
    }
}
