@page "/manager/services/{id:int}/edit"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Data.Entities
@using Web.Components.Pages.Manager.Services
@inject NavigationManager Navigation
@inject global::Services.Interfaces.IServiceService ServiceService
@rendermode InteractiveServer

<PageTitle>Chỉnh sửa Service (Manager)</PageTitle>

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/manager/services">Service Management</a></li>
            <li class="breadcrumb-item active">Chỉnh sửa Service</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h3 class="mb-0">Chỉnh sửa Service</h3>
                </div>
                <div class="card-body">
                    <EditForm Model="serviceModel" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="mb-3">
                            <label for="serviceName" class="form-label">Service Name <span class="text-danger">*</span></label>
                            <InputText id="serviceName" class="form-control" @bind-Value="serviceModel.ServiceName" placeholder="Enter service name" />
                            <ValidationMessage For="@(() => serviceModel.ServiceName)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label for="description" class="form-label">Description <span class="text-danger">*</span></label>
                            <InputTextArea id="description" class="form-control" @bind-Value="serviceModel.Description"
                                           placeholder="Enter detailed service description" rows="4" />
                            <ValidationMessage For="@(() => serviceModel.Description)" class="text-danger" />
                            <div class="form-text">Provide a comprehensive description of what this service includes.</div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="price" class="form-label">Price ($) <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <InputNumber id="price" class="form-control" @bind-Value="serviceModel.Price"
                                                     placeholder="0.00" step="0.01" />
                                    </div>
                                    <ValidationMessage For="@(() => serviceModel.Price)" class="text-danger" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="duration" class="form-label">Duration <span class="text-danger">*</span></label>
                                    <InputSelect id="duration" class="form-select" @bind-Value="serviceModel.Duration">
                                        <option value="">Select duration</option>
                                        <option value="1-2 weeks">1-2 weeks</option>
                                        <option value="2-3 weeks">2-3 weeks</option>
                                        <option value="3-4 weeks">3-4 weeks</option>
                                        <option value="4-6 weeks">4-6 weeks</option>
                                        <option value="6-8 weeks">6-8 weeks</option>
                                        <option value="2-3 months">2-3 months</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => serviceModel.Duration)" class="text-danger" />
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fas fa-save me-2"></i>
                                Cập nhật
                            </button>
                            <a href="/manager/services" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Preview</h5>
                </div>
                <div class="card-body">
                    <div class="service-preview">
                        <h6 class="text-primary">@(string.IsNullOrEmpty(serviceModel.ServiceName) ? "Service Name" : serviceModel.ServiceName)</h6>
                        <div class="h5 text-success mb-2">
                            $@(serviceModel.Price?.ToString("F2") ?? "0.00")
                        </div>
                        <div class="mb-2 text-muted">@(string.IsNullOrEmpty(serviceModel.Duration) ? "Duration" : serviceModel.Duration)</div>
                        <div>@(string.IsNullOrEmpty(serviceModel.Description) ? "Service description preview..." : serviceModel.Description)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private ServiceCreateModel serviceModel = new();
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        // Load service from DB and map to model
        var entity = await ServiceService.GetByIdAsync(Id);
        if (entity != null)
        {
            serviceModel = new ServiceCreateModel
            {
                ServiceName = entity.ServiceName,
                Description = entity.Description,
                Price = entity.Price,
                Duration = entity.Duration
            };
        }
        else
        {
            // Nếu không tìm thấy, có thể chuyển hướng hoặc báo lỗi
            Navigation.NavigateTo("/manager/services");
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            isSubmitting = true;
            Console.WriteLine("HandleValidSubmit called!");

            // Lấy lại entity từ DB
            var entity = await ServiceService.GetByIdAsync(Id);
            if (entity == null)
            {
                Console.WriteLine("Service not found for update!");
                return;
            }

            // Cập nhật property
            entity.ServiceName = serviceModel.ServiceName;
            entity.Description = serviceModel.Description;
            entity.Price = serviceModel.Price ?? 0;
            entity.Duration = serviceModel.Duration;

            await ServiceService.UpdateAsync(entity);
            Console.WriteLine("UpdateAsync called!");
            Navigation.NavigateTo("/manager/services");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating service: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void HandleInvalidSubmit(EditContext context)
    {
        Console.WriteLine("Form validation failed!");
        Console.WriteLine($"ServiceName: '{serviceModel.ServiceName}' - IsValid: {!string.IsNullOrEmpty(serviceModel.ServiceName)}");
        Console.WriteLine($"Description: '{serviceModel.Description}' - IsValid: {!string.IsNullOrEmpty(serviceModel.Description)}");
        Console.WriteLine($"Price: {serviceModel.Price} - IsValid: {serviceModel.Price.HasValue && serviceModel.Price > 0}");
        Console.WriteLine($"Duration: '{serviceModel.Duration}' - IsValid: {!string.IsNullOrEmpty(serviceModel.Duration)}");
        foreach (var error in context.GetValidationMessages())
        {
            Console.WriteLine($"Validation error: {error}");
        }
    }
} 