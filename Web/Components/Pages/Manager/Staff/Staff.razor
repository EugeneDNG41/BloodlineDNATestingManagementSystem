@page "/manager/staff"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Data.Entities
@using Microsoft.AspNetCore.Authorization
@inject Data.AppDbContext DbContext
@inject UserManager<User> UserManager
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Manager")]

<PageTitle>Staff Management</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">Staff Management</h1>
        <a href="/admin/users/create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Add New Staff
        </a>
    </div>

    <!-- Staff Statistics -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <i class="fas fa-users fa-2x mb-2"></i>
                    <h3>@totalStaff</h3>
                    <p class="mb-0">Total Staff</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <i class="fas fa-user-check fa-2x mb-2"></i>
                    <h3>@activeStaff</h3>
                    <p class="mb-0">Active Staff</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body text-center">
                    <i class="fas fa-user-clock fa-2x mb-2"></i>
                    <h3>@newStaffThisMonth</h3>
                    <p class="mb-0">New This Month</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <input type="text" class="form-control" placeholder="Search staff..." @bind="searchTerm" @oninput="FilterStaff">
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="SelectedStatus">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100" @onclick="ResetFilters">
                        <i class="fas fa-undo me-1"></i>Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Staff Table -->
    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Staff Members (@filteredStaff.Count)</h5>
        </div>
        <div class="card-body p-0">
            @if (filteredStaff?.Any() == true)
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Staff Member</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Joined</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var staff in filteredStaff)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(staff.ProfilePictureUrl))
                                            {
                                                <img src="@staff.ProfilePictureUrl" alt="Profile" class="rounded-circle me-2" style="width: 40px; height: 40px;">
                                            }
                                            else
                                            {
                                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                                                    @staff.FullName.Substring(0, 1).ToUpper()
                                                </div>
                                            }
                                            <div>
                                                <div class="fw-semibold">@staff.FullName</div>
                                                <small class="text-muted">Staff ID: @staff.Id.Substring(0, 8)</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @staff.Email
                                        @if (staff.EmailConfirmed)
                                        {
                                            <i class="fas fa-check-circle text-success ms-1" title="Email Verified"></i>
                                        }
                                    </td>
                                    <td>@(staff.PhoneNumber ?? "Not provided")</td>
                                    <td>@staff.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (staff.LockoutEnd.HasValue && staff.LockoutEnd > DateTime.UtcNow)
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="/admin/users/@staff.Id" class="btn btn-outline-primary" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="/admin/users/@staff.Id/edit" class="btn btn-outline-secondary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            @if (staff.LockoutEnd.HasValue && staff.LockoutEnd > DateTime.UtcNow)
                                            {
                                                <button class="btn btn-outline-success" @onclick="() => ActivateStaff(staff.Id)" title="Activate">
                                                    <i class="fas fa-user-check"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-warning" @onclick="() => DeactivateStaff(staff.Id)" title="Deactivate">
                                                    <i class="fas fa-user-times"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No staff members found</h4>
                    <p class="text-muted">Try adjusting your search criteria</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<User> staffMembers = new();
    private List<User> filteredStaff = new();
    
    private int totalStaff;
    private int activeStaff;
    private int newStaffThisMonth;
    
    private string searchTerm = "";
    private string selectedStatus = "";
    public string SelectedStatus
    {
        get => selectedStatus;
        set
        {
            selectedStatus = value;
            FilterStaff();
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await LoadStaffData();
        LoadStatistics();
        filteredStaff = staffMembers.ToList();
    }

    private async Task LoadStaffData()
    {
        staffMembers = (await UserManager.GetUsersInRoleAsync("Staff")).ToList();
    }

    private void LoadStatistics()
    {
        var now = DateTime.UtcNow;
        var startOfMonth = new DateTime(now.Year, now.Month, 1);

        totalStaff = staffMembers.Count;
        activeStaff = staffMembers.Count(s => !s.LockoutEnd.HasValue || s.LockoutEnd <= now);
        newStaffThisMonth = staffMembers.Count(s => s.CreatedAt >= startOfMonth);
    }

    private void FilterStaff()
    {
        filteredStaff = staffMembers.Where(s =>
            (string.IsNullOrEmpty(searchTerm) || 
             s.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             s.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&          
            (string.IsNullOrEmpty(selectedStatus) || 
             (selectedStatus == "Active" && (!s.LockoutEnd.HasValue || s.LockoutEnd <= DateTime.UtcNow)) ||
             (selectedStatus == "Inactive" && s.LockoutEnd.HasValue && s.LockoutEnd > DateTime.UtcNow))
        ).ToList();
    }

    private void ResetFilters()
    {
        searchTerm = "";
        selectedStatus = "";
        filteredStaff = staffMembers.ToList();
    }

    private string GetDepartmentBadgeClass(string? department)
    {
        return department switch
        {
            "Laboratory" => "bg-info",
            "Reception" => "bg-primary",
            "Administration" => "bg-secondary",
            "Medical" => "bg-success",
            _ => "bg-light text-dark"
        };
    }

    private async Task ActivateStaff(string staffId)
    {
        var staff = await UserManager.FindByIdAsync(staffId);
        if (staff != null)
        {
            await UserManager.SetLockoutEndDateAsync(staff, null);
            await LoadStaffData();
            LoadStatistics();
            FilterStaff();
        }
    }

    private async Task DeactivateStaff(string staffId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to deactivate this staff member?");
        if (confirmed)
        {
            var staff = await UserManager.FindByIdAsync(staffId);
            if (staff != null)
            {
                await UserManager.SetLockoutEndDateAsync(staff, DateTimeOffset.UtcNow.AddYears(100));
                await LoadStaffData();
                LoadStatistics();
                FilterStaff();
            }
        }
    }
}
