@page "/admin/services"
@using Microsoft.AspNetCore.Components
@using Data.Entities
@inject IJSRuntime JSRuntime

<PageTitle>Service Management</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">Service Management</h1>
        <a href="/admin/services/create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Add New Service
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="mb-0">Services (@services.Count)</h5>
                </div>
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Search services..." @bind="searchTerm" @oninput="FilterServices">
                        <button class="btn btn-outline-secondary" type="button">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            @if (filteredServices?.Any() == true)
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Service Name</th>
                                <th>Price</th>
                                <th>Duration</th>
                                <th>Appointments</th>
                                <th>Reviews</th>
                                <th>Status</th>
                                <th width="200">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var service in filteredServices)
                            {
                                <tr>
                                    <td>
                                        <div>
                                            <strong>@service.ServiceName</strong>
                                            <br>
                                            <small class="text-muted">@(service.Description.Length > 50 ? service.Description.Substring(0, 50) + "..." : service.Description)</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success">$@service.Price.ToString("F2")</span>
                                    </td>
                                    <td>@service.Duration</td>
                                    <td>
                                        <span class="badge bg-info">@service.Appointments?.Count ?? 0</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="badge bg-warning me-1">@service.Reviews?.Count ?? 0</span>
                                            <small class="text-muted">4.8★</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-success">Active</span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a href="/admin/services/@service.Id" class="btn btn-outline-primary" title="View">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="/admin/services/@service.Id/edit" class="btn btn-outline-secondary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button class="btn btn-outline-danger" @onclick="() => DeleteService(service.Id)" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No services found</h4>
                    <p class="text-muted">Create your first service to get started</p>
                    <a href="/admin/services/create" class="btn btn-primary">Add New Service</a>
                </div>
            }
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4>@services.Count</h4>
                            <p class="mb-0">Total Services</p>
                        </div>
                        <i class="fas fa-vial fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4>@services.Sum(s => s.Appointments?.Count ?? 0)</h4>
                            <p class="mb-0">Total Appointments</p>
                        </div>
                        <i class="fas fa-calendar fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4>$@services.Sum(s => s.Price).ToString("F0")</h4>
                            <p class="mb-0">Total Revenue Potential</p>
                        </div>
                        <i class="fas fa-dollar-sign fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4>@services.Sum(s => s.Reviews?.Count ?? 0)</h4>
                            <p class="mb-0">Total Reviews</p>
                        </div>
                        <i class="fas fa-star fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Service> services = new();
    private List<Service> filteredServices = new();
    private string searchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadServices();
        filteredServices = services.ToList();
    }

    private async Task LoadServices()
    {
        // Replace with actual service call
        services = new List<Service>
        {
            new Service {
                Id = 1,
                ServiceName = "Basic Ancestry DNA",
                Description = "Discover your ethnic background and find DNA matches with our basic ancestry test.",
                Price = 99.99m,
                Duration = "2-3 weeks",
                Appointments = new List<Appointment> { new(), new(), new() },
                Reviews = new List<Review> { new(), new(), new(), new(), new() }
            },
            new Service {
                Id = 2,
                ServiceName = "Advanced Bloodline Analysis",
                Description = "Comprehensive bloodline analysis including detailed family tree construction.",
                Price = 299.99m,
                Duration = "4-6 weeks",
                Appointments = new List<Appointment> { new(), new() },
                Reviews = new List<Review> { new(), new(), new() }
            },
            new Service {
                Id = 3,
                ServiceName = "Paternity Testing",
                Description = "Accurate paternity testing with 99.9% accuracy.",
                Price = 199.99m,
                Duration = "1-2 weeks",
                Appointments = new List<Appointment> { new(), new(), new(), new(), new() },
                Reviews = new List<Review> { new(), new() }
            }
        };
    }

    private void FilterServices()
    {
        filteredServices = services.Where(s =>
            string.IsNullOrEmpty(searchTerm) ||
            s.ServiceName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            s.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
        ).ToList();
    }

    private async Task DeleteService(int serviceId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this service?");
        if (confirmed)
        {
            // Implement delete logic
            services.RemoveAll(s => s.Id == serviceId);
            FilterServices();
        }
    }
}