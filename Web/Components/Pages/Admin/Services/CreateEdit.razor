@page "/admin/services/create"
@page "/admin/services/{id:int}/edit"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Data.Entities
@using System.ComponentModel.DataAnnotations;
@inject NavigationManager Navigation

<PageTitle>@(Id.HasValue ? "Edit Service" : "Create Service")</PageTitle>

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin/services">Service Management</a></li>
            <li class="breadcrumb-item active">@(Id.HasValue ? "Edit Service" : "Create Service")</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h3 class="mb-0">@(Id.HasValue ? "Edit Service" : "Create New Service")</h3>
                </div>
                <div class="card-body">
                    <EditForm Model="serviceModel" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="serviceName" class="form-label">Service Name <span class="text-danger">*</span></label>
                            <InputText id="serviceName" class="form-control" @bind-Value="serviceModel.ServiceName" placeholder="Enter service name" />
                            <ValidationMessage For="@(() => serviceModel.ServiceName)" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">Description <span class="text-danger">*</span></label>
                            <InputTextArea id="description" class="form-control" @bind-Value="serviceModel.Description"
                                           placeholder="Enter detailed service description" rows="4" />
                            <ValidationMessage For="@(() => serviceModel.Description)" class="text-danger" />
                            <div class="form-text">Provide a comprehensive description of what this service includes.</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="price" class="form-label">Price ($) <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <InputNumber id="price" class="form-control" @bind-Value="serviceModel.Price"
                                                     placeholder="0.00" step="0.01" />
                                    </div>
                                    <ValidationMessage For="@(() => serviceModel.Price)" class="text-danger" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="duration" class="form-label">Duration <span class="text-danger">*</span></label>
                                    <InputSelect id="duration" class="form-select" @bind-Value="serviceModel.Duration">
                                        <option value="">Select duration</option>
                                        <option value="1-2 weeks">1-2 weeks</option>
                                        <option value="2-3 weeks">2-3 weeks</option>
                                        <option value="3-4 weeks">3-4 weeks</option>
                                        <option value="4-6 weeks">4-6 weeks</option>
                                        <option value="6-8 weeks">6-8 weeks</option>
                                        <option value="2-3 months">2-3 months</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => serviceModel.Duration)" class="text-danger" />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fas fa-save me-2"></i>
                                @(Id.HasValue ? "Update Service" : "Create Service")
                            </button>
                            <a href="/admin/services" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Preview</h5>
                </div>
                <div class="card-body">
                    <div class="service-preview">
                        <h6 class="text-primary">@(string.IsNullOrEmpty(serviceModel.ServiceName) ? "Service Name" : serviceModel.ServiceName)</h6>
                        <div class="h5 text-success mb-2">
                            $@(serviceModel.Price?.ToString("F2") ?? "0.00")
                        </div>
                        <p class="text-muted small">
                            @(string.IsNullOrEmpty(serviceModel.Description) ? "Service description will appear here..." : serviceModel.Description)
                        </p>
                        <div class="mb-2">
                            <small class="text-muted">
                                <i class="fas fa-clock me-1"></i>
                                Duration: @(string.IsNullOrEmpty(serviceModel.Duration) ? "Not specified" : serviceModel.Duration)
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-header">
                    <h6 class="mb-0">Tips</h6>
                </div>
                <div class="card-body">
                    <ul class="small mb-0">
                        <li>Use clear, descriptive service names</li>
                        <li>Include all relevant details in the description</li>
                        <li>Set competitive pricing based on market research</li>
                        <li>Be realistic with duration estimates</li>
                        <li>Highlight unique features and benefits</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private ServiceModel serviceModel = new();
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await LoadService();
        }
    }

    private async Task LoadService()
    {
        // Replace with actual service call
        var service = new Service
            {
                Id = Id.Value,
                ServiceName = "Basic Ancestry DNA",
                Description = "Discover your ethnic background and find DNA matches.",
                Price = 99.99m,
                Duration = "2-3 weeks"
            };

        serviceModel = new ServiceModel
            {
                ServiceName = service.ServiceName,
                Description = service.Description,
                Price = service.Price,
                Duration = service.Duration
            };
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;

        try
        {
            // Implement save logic here
            await Task.Delay(1000); // Simulate API call

            Navigation.NavigateTo("/admin/services");
        }
        finally
        {
            isSubmitting = false;
        }
    }


    public class ServiceModel
    {
        [Required(ErrorMessage = "Service name is required")]
        [StringLength(100, ErrorMessage = "Service name cannot exceed 100 characters")]
        public string ServiceName { get; set; } = "";

        [Required(ErrorMessage = "Description is required")]
        [StringLength(1000, ErrorMessage = "Description cannot exceed 1000 characters")]
        public string Description { get; set; } = "";

        [Required(ErrorMessage = "Price is required")]
        [Range(0.01, 10000, ErrorMessage = "Price must be between $0.01 and $10,000")]
        public decimal? Price { get; set; }

        [Required(ErrorMessage = "Duration is required")]
        public string Duration { get; set; } = "";
    }
}