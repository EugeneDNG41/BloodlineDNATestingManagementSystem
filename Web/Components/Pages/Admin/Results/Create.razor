@page "/admin/results/create"
@using Data.Entities
@using Data.Enum
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@using global::Services.Interfaces
@inject IResultService ResultService
@inject UserManager<User> UserManager
@inject Data.AppDbContext DbContext
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Admin,Manager,Staff")]

<PageTitle>Create New Result</PageTitle>

<div class="container py-4">
    <h1 class="h2 mb-4">Create New Result</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <EditForm Model="InputModel" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Customer</label>
                        <InputSelect @bind-Value="InputModel.UserId" class="form-select">
                            <option value="">Select a customer...</option>
                            @foreach (var user in customerList)
                            {
                                <option value="@user.Id">@user.FullName (@user.Email)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Service</label>
                        <InputSelect @bind-Value="InputModel.ServiceId" class="form-select">
                            <option value="0">Select a service...</option>
                            @foreach (var service in serviceList)
                            {
                                <option value="@service.Id">@service.ServiceName</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Summary</label>
                    <InputText @bind-Value="InputModel.Summary" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Analysis Type</label>
                    <InputSelect @bind-Value="InputModel.Type" class="form-select">
                        @foreach (AnalysisType type in Enum.GetValues(typeof(AnalysisType)))
                        {
                            <option value="@type">@type</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">Link Completed Samples</label>
                    @if (availableSamples.Any())
                    {
                        <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                            @foreach (var sample in availableSamples)
                            {
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="sample-@sample.Id" @onchange="(e) => ToggleSampleSelection(sample.Id, e.Value)" />
                                    <label class="form-check-label" for="sample-@sample.Id">
                                        Sample ID: @sample.Id.ToString("D6") - Type: @sample.Type - Collected: @sample.CollectionDate.ToShortDateString()
                                    </label>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No completed samples available for the selected user.</p>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">Notes / Detailed Results</label>
                    <InputTextArea @bind-Value="InputModel.Notes" class="form-control" rows="5" />
                </div>

                <button type="submit" class="btn btn-primary">Create Result</button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private ResultInputModel InputModel { get; set; } = new();

    private List<User> customerList = new();
    private List<Service> serviceList = new();
    private List<Sample> availableSamples = new();

    protected override async Task OnInitializedAsync()
    {
        var customerRole = await DbContext.Roles.FirstAsync(r => r.Name == "Customer");
        customerList = await DbContext.Users
            .Where(u => DbContext.UserRoles.Any(ur => ur.RoleId == customerRole.Id && ur.UserId == u.Id))
            .ToListAsync();

        serviceList = await DbContext.Services.ToListAsync();

        // Watch for changes in the selected user to update the available samples list
        InputModel.OnUserChanged += async (userId) =>
        {
            if (!string.IsNullOrEmpty(userId))
            {
                availableSamples = await DbContext.Samples
                    .Where(s => s.DonorId == userId && s.Status == SampleStatus.Completed && s.ResultId == null)
                    .ToListAsync();
            }
            else
            {
                availableSamples.Clear();
            }
            StateHasChanged();
        };
    }

    private void ToggleSampleSelection(int sampleId, object isChecked)
    {
        if ((bool)isChecked)
        {
            if (!InputModel.SelectedSampleIds.Contains(sampleId))
            {
                InputModel.SelectedSampleIds.Add(sampleId);
            }
        }
        else
        {
            InputModel.SelectedSampleIds.Remove(sampleId);
        }
    }

    private async Task HandleValidSubmit()
    {
        var newResult = new Result
        {
            UserId = InputModel.UserId,
            ServiceId = InputModel.ServiceId,
            Summary = InputModel.Summary,
            Type = InputModel.Type,
            Notes = InputModel.Notes,
            CreatedAt = DateTime.UtcNow
        };

        await ResultService.CreateResultAsync(newResult, InputModel.SelectedSampleIds);

        // Navigate to a success page or the new result's details page
        NavigationManager.NavigateTo("/admin/samples");
    }

    public class ResultInputModel
    {
        private string _userId = "";

        [Required]
        public string UserId
        {
            get => _userId;
            set
            {
                if (_userId != value)
                {
                    _userId = value;
                    OnUserChanged?.Invoke(_userId);
                }
            }
        }

        [Range(1, int.MaxValue, ErrorMessage = "Please select a service.")]
        public int ServiceId { get; set; }

        [Required]
        public string Summary { get; set; } = "";

        [Required]
        public AnalysisType Type { get; set; }

        [Required]
        public string Notes { get; set; } = "";

        [MinLength(1, ErrorMessage = "Please select at least one sample.")]
        public List<int> SelectedSampleIds { get; set; } = new();

        public event Func<string, Task>? OnUserChanged;
    }
}