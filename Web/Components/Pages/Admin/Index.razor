@page "/admin"
@page "/admin/dashboard"
@using Microsoft.EntityFrameworkCore
@using Data.Entities
@using Data.Enum
@using Microsoft.AspNetCore.Authorization
@inject Data.AppDbContext DbContext
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Admin Dashboard</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">Admin Dashboard</h1>
        <div class="d-flex gap-2">
            <span class="badge bg-success">System Online</span>
            <span class="text-muted">Last updated: @DateTime.Now.ToString("MMM dd, yyyy HH:mm")</span>
        </div>
    </div>

    <!-- Key Metrics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-6 col-md-6">
            <div class="card bg-primary text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="h2 mb-0">@totalUsers</div>
                            <div>Total Users</div>
                            <small class="opacity-75">+@newUsersThisMonth this month</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-users fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="col-xl-6 col-md-6">
            <div class="card bg-warning text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="h2 mb-0">$@totalRevenue.ToString("N0")</div>
                            <div>Total Revenue</div>
                            <small class="opacity-75">$@monthlyRevenue this month</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-dollar-sign fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mt-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Appointments Overview</h5>
                </div>
                <div class="card-body">
                    <canvas id="appointmentsChart" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-sm {
        width: 32px;
        height: 32px;
        font-size: 14px;
    }
</style>

@code {
    private int totalUsers;
    private int newUsersThisMonth;
    private int totalAppointments;
    private int appointmentsToday;
    private decimal totalRevenue;
    private decimal monthlyRevenue;

    private List<Appointment> recentAppointments = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        var now = DateTime.UtcNow;
        var startOfMonth = new DateTime(now.Year, now.Month, 1);
        var today = now.Date;

        // Load metrics
        totalUsers = await DbContext.Users.CountAsync();
        newUsersThisMonth = await DbContext.Users.CountAsync(u => u.CreatedAt >= startOfMonth);

        totalAppointments = await DbContext.Appointments.CountAsync();
        appointmentsToday = await DbContext.Appointments.CountAsync(a => a.ScheduledAt.Date == today);

        // Calculate revenue (simplified - you might want to add actual payment tracking)
        var appointments = await DbContext.Appointments.Where(a => a.Status == AppointmentStatus.Completed && !a.IsDeleted).Include(a => a.Service).ToListAsync();
        totalRevenue = appointments.Sum(a => a.Service.Price) * 0.7m; // Estimated
        monthlyRevenue = totalRevenue * 0.1m; // Estimated monthly

        // Load recent appointments
        recentAppointments = await DbContext.Appointments
            .Include(a => a.User)
            .Include(a => a.Service)
            .OrderByDescending(a => a.CreatedAt)
            .Take(10)
            .ToListAsync();
    }

    private string GetStatusBadgeClass(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Scheduled => "bg-primary",
            AppointmentStatus.Completed => "bg-success",
            AppointmentStatus.Cancelled => "bg-danger",
            AppointmentStatus.NoShow => "bg-warning",
            _ => "bg-secondary"
        };
    }
}
