@page "/blog/create"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Data.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using global::Services.Interfaces
@using System.Security.Claims

@attribute [Authorize(Roles = "Staff")]
@inject IPostService PostService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Create Blog Post</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Create Blog Post</h1>
        <a href="/admin/blog" class="btn btn-outline-primary">
            <i class="fas fa-list me-2"></i>Back to Posts
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            @errorMessage
                        </div>
                    }

                    <EditForm Model="Input" OnValidSubmit="HandleValidSubmit" FormName="CreateBlogPostForm">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="mb-4">
                            <label for="title" class="form-label">Title <span class="text-danger">*</span></label>
                            <InputText id="title"
                                       class="form-control"
                                       @bind-Value="Input.Title"
                                       placeholder="Enter post title..."
                                       aria-required="true" />
                            <ValidationMessage For="@(() => Input.Title)" class="text-danger" />
                        </div>

                        <div class="mb-4">
                            <label for="content" class="form-label">Content <span class="text-danger">*</span></label>
                            <InputTextArea id="content"
                                           class="form-control"
                                           rows="15"
                                           @bind-Value="Input.Content"
                                           placeholder="Write your blog post content here..."
                                           aria-required="true" />
                            <ValidationMessage For="@(() => Input.Content)" class="text-danger" />
                            <small class="text-muted">Minimum 50 characters required.</small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                }
                                <i class="fas fa-save me-2"></i>
                                Create Post
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="NavigateBack">
                                <i class="fas fa-times me-2"></i>Cancel
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="card-title mb-0">Publishing Guidelines</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            Title should be clear and concise
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            Content should be at least 50 characters
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            Check formatting before publishing
                        </li>
                        <li>
                            <i class="fas fa-check-circle text-success me-2"></i>
                            Review content for accuracy
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? errorMessage;
    private bool isSubmitting = false;
    private string? currentUserId;

    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    }

    public class InputModel
    {
        [Required(ErrorMessage = "Title is required")]
        [StringLength(100, MinimumLength = 5, ErrorMessage = "Title must be between {2} and {1} characters")]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Content is required")]
        [MinLength(50, ErrorMessage = "Content must be at least {1} characters")]
        public string Content { get; set; } = string.Empty;

        public bool IsPublished { get; set; } = true;
    }

    private async Task HandleValidSubmit()
    {
        if (string.IsNullOrEmpty(currentUserId))
        {
            errorMessage = "Unable to determine current user.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var post = new Post
            {
                Title = Input.Title,
                Content = Input.Content,
                AuthorId = currentUserId,
                 IsPublished = false,
            };

            await PostService.CreatePostAsync(post);
            NavigationManager.NavigateTo("/blog");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating post: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/blog");
    }
}
