@page "/blog"
@using Microsoft.EntityFrameworkCore
@using Data.Entities
@inject Data.AppDbContext DbContext

<PageTitle>DNA Testing Blog</PageTitle>

<div class="container py-4">
    <div class="row">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2">DNA Testing Blog</h1>
                <div class="input-group" style="max-width: 300px;">
                    <input type="text" class="form-control" placeholder="Search articles..." @bind="searchTerm" @oninput="FilterPosts">
                    <button class="btn btn-outline-primary" type="button">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>

            @if (filteredPosts?.Any() == true)
            {
                @foreach (var post in filteredPosts)
                {
                    <article class="card shadow-sm mb-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h2 class="h4 card-title">
                                        <a href="/blog/@post.Id" class="text-decoration-none">@post.Title</a>
                                    </h2>
                                    <div class="text-muted small">
                                        <i class="fas fa-user me-1"></i>By @post.Author.FullName
                                        <span class="mx-2">•</span>
                                        <i class="fas fa-calendar me-1"></i>@post.CreatedAt.ToString("MMMM dd, yyyy")
                                    </div>
                                </div>
                            </div>
                            
                            <p class="card-text text-muted">
                                @(post.Content.Length > 200 ? 
                                  System.Text.RegularExpressions.Regex.Replace(post.Content.Substring(0, 200), "<.*?>", "") + "..." : 
                                  System.Text.RegularExpressions.Regex.Replace(post.Content, "<.*?>", ""))
                            </p>
                            
                            <a href="/blog/@post.Id" class="btn btn-outline-primary">
                                Read More <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-newspaper fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No articles found</h4>
                    <p class="text-muted">Check back soon for new articles about DNA testing and genetics</p>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Recent Articles</h5>
                </div>
                <div class="card-body">
                    @if (recentPosts?.Any() == true)
                    {
                        @foreach (var post in recentPosts.Take(5))
                        {
                            <div class="mb-3 pb-3 @(post != recentPosts.Last() ? "border-bottom" : "")">
                                <h6 class="mb-1">
                                    <a href="/blog/@post.Id" class="text-decoration-none">@post.Title</a>
                                </h6>
                                <small class="text-muted">@post.CreatedAt.ToString("MMM dd, yyyy")</small>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Popular Topics</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-primary">DNA Basics</span>
                        <span class="badge bg-secondary">Paternity Testing</span>
                        <span class="badge bg-success">Ancestry</span>
                        <span class="badge bg-info">Health Genetics</span>
                        <span class="badge bg-warning">Sample Collection</span>
                        <span class="badge bg-danger">Results Interpretation</span>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Need DNA Testing?</h5>
                    <p class="text-muted">Ready to discover your genetic story? Browse our comprehensive DNA testing services.</p>
                    <a href="/services" class="btn btn-primary">
                        <i class="fas fa-vial me-2"></i>View Services
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Post> posts = new();
    private List<Post> filteredPosts = new();
    private List<Post> recentPosts = new();
    private string searchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadPosts();
        filteredPosts = posts.ToList();
        recentPosts = posts.Take(5).ToList();
    }

    private async Task LoadPosts()
    {
        posts = await DbContext.Posts
            .Include(p => p.Author)
            .Where(p => p.IsPublished)
            .OrderByDescending(p => p.CreatedAt)
            .ToListAsync();
    }

    private void FilterPosts()
    {
        filteredPosts = posts.Where(p =>
            string.IsNullOrEmpty(searchTerm) || 
            p.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            p.Content.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
        ).ToList();
    }
}
